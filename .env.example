# =============================================================================
# onetwoInventory — Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before starting the app.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Full public URL of the app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://ims.yourdomain.com

# Node environment: development | production
NODE_ENV=production

# What this DEPLOYMENT is: production | stage | development | e2e
#
# NODE_ENV above cannot carry this. It is set by the BUILD — `next build` and
# `next start` both mean `production` — so it says the same thing on the real
# production server, on stage, on a second production-shaped copy and on the
# full-chain rig. Controls that exempt production therefore exempt all of them,
# which is how a rig with no Xero tenant control of its own stayed exempt from
# the requirement to name one (o3d-l89a, after o3d-t74p).
#
# Set it on EVERY instance, and set it to something other than `production` on
# every instance that is not the production one. Production preflight warns
# while it is unset and fails when it is set to anything but `production`;
# once production's .env carries the line, an absent value will read as
# NON-PRODUCTION rather than falling back to NODE_ENV.
IMS_INSTANCE_ROLE=production

# Content-Security-Policy mode (build-time, read by the middleware):
#   report-only (default) — emit Content-Security-Policy-Report-Only; nothing is
#                           blocked. Use this first and watch the browser console
#                           / report endpoint for violations.
#   enforce               — emit an enforcing Content-Security-Policy. Switch to
#                           this only after confirming there are no violations.
#   off                   — do not emit any CSP.
# CSP_MODE=report-only

# Secret used to sign/encrypt Auth.js sessions (min 32 random chars)
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_32

# High-risk admin actions require re-authentication when the login is older
# than this many seconds. Defaults to 900 (15 minutes); maximum is 86400 (24h).
FRESH_AUTH_MAX_AGE_SECONDS=900

# Invoice PDF signed download links expire after this many seconds.
# Lower values reduce leaked-link exposure; higher values reduce customer
# "link expired" friction.
INVOICE_PDF_TOKEN_TTL_SECONDS=259200
# Maximum accepted invoice PDF token lifetime. Defaults to 2592000 (30 days)
# and is capped at 2592000 even if set higher.
INVOICE_PDF_TOKEN_MAX_TTL_SECONDS=2592000

# Persistent storage for accounting connector invoice PDFs served through signed
# invoice links. Optional in development (local fallback: ./data/invoices);
# required by production preflight.
INVOICE_PDF_STORAGE_DIR=/var/lib/onetwoinventory/invoice-pdfs

# 32-byte AES key used to encrypt sensitive Setting values stored in the database.
# Accepted formats: base64 that decodes to 32 bytes (openssl rand -base64 32),
# 64-character hex (openssl rand -hex 32), or a raw 32-byte string.
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_-base64_32

# Legacy fallback for older installs. New installs should use
# SETTINGS_ENCRYPTION_KEY; keep this set to the same value while migrating.
ENCRYPTION_KEY=

# Bearer token used to authorize internal cron endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_generate_with_openssl_rand_-hex_32

# Per-run cap for Xero daily batch journal candidate rows per group. The default
# is 1000 and values above 5000 are clamped.
XERO_DAILY_BATCH_LIMIT=1000

# Auth.js base URL (same as NEXT_PUBLIC_APP_URL)
AUTH_URL=https://ims.yourdomain.com

# Trusted reverse proxies for auth/login IP extraction. Comma-separated exact
# IPs and/or CIDRs, walked from the right side of X-Forwarded-For.
# Leave blank for a single proxy that overwrites/appends X-Forwarded-For itself.
# Set REQUIRE_TRUSTED_PROXY_CONFIG=true when the deployment is behind proxies
# and preflight must fail if no trusted proxy entries are configured.
REQUIRE_TRUSTED_PROXY_CONFIG=false
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_CIDRS=

# Cloudflare Turnstile for the password login form. Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Login/TOTP and cron rate-limit backend. Use memory for single-process/local
# installs. Use redis with REDIS_URL for cluster-wide throttling when IMS runs
# behind a load balancer or multiple application replicas.
#
# The credential belongs IN the URL — redis://:PASSWORD@host:port/db, with the
# password percent-encoded. That is what the client connects with, and it is the
# only form that can express a Redis 6 ACL username. REDIS_PASSWORD below is a
# compatibility fallback for a URL that carries no credential; set one or the
# other, not both, because two different values are refused rather than resolved
# by precedence. Getting this wrong is not a visible Redis outage: the login
# rate-limit buckets fail CLOSED, so a Redis answering NOAUTH surfaces as nobody
# being able to sign in.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------

# Full Postgres connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# A TRANSACTION-POOLING PROXY IN FRONT OF THIS URL IS NOT SUPPORTED, AND SUPPORT
# IS NOT PLANNED -- PgBouncer pool_mode = transaction, Odyssey pool "transaction",
# pgcat, RDS Proxy, a provider's "pooled" port. Point this at PostgreSQL itself.
# WHY: the money post, the daily Xero accounting batch, the daily QuickBooks
# accounting batch, the Xero payment write, the WMS dispatch sweep and the restore
# fence are held by PostgreSQL SESSION advisory locks. Such a lock belongs to one
# backend session, and pooling destroys the AFFINITY between the IMS client that
# took it and that session -- that part is true of every pooler. What becomes of the
# lock is PER IMPLEMENTATION: returning a backend to a transaction pool does not by
# itself end its PostgreSQL session, so a pooler may reset/discard the connection
# and release the lock, or leave it attached to a backend handed to another client.
# Measured, and attributed rather than generalised: PgBouncer 1.24.1 in transaction
# mode multiplexed ONE client connection across TWO backends; Odyssey 1.5.3-rc1 in
# transaction-pooling mode released the lock, so two clients were each told they
# held the same advisory key while pg_locks showed neither did -- for the money-post
# lock, the same document paid twice.
# WHAT IS ENFORCED: every session-lock connection proves, unconditionally and on
# every schema, that the backend answering it is on the other end of this process's
# own socket, so a pooled deployment is REFUSED at the FIRST SESSION-LOCK
# ACQUISITION -- a money post, either daily accounting batch, a Xero payment write,
# a dispatch sweep or a restore, whichever runs first (six jobs on four locks: the
# money post and both daily batches share lib/db/pinned-advisory-lock.ts) -- closed
# and loud, not a silent double payment.
# WHAT IS NOT DETECTED: the ordinary data path attaches no such check (by design,
# so ordinary traffic pays nothing), so a pooled deployment boots and serves right
# up until one of those six jobs runs -- and two of them are SCHEDULED batches, so
# the first refusal may be a cron run nobody was watching rather than a money post;
# and DATABASE_SESSION_LOCK_URL below takes
# the lock connections past the pooler and with them the refusal -- the data path
# stays pooled, stays unsupported, and nothing reports it.
DATABASE_URL=postgresql://imsuser:CHANGE_ME@localhost:5432/onetwoinventory

# Optional production preflight database connectivity probe. Keep false in
# build-only CI jobs that do not provision Postgres.
PREFLIGHT_DB_CONNECT=false

# THIS DOES NOT MAKE A POOLED DATABASE_URL SUPPORTED (see above); it only keeps the
# four session locks correct where something is nonetheless interposed, and says
# nothing about the data path. Set it
# ONLY IF THE LOCK CONNECTIONS CANNOT BE SHOWN TO REACH POSTGRESQL DIRECTLY —
# i.e. DATABASE_URL points at a connection pooler (PgBouncer, Odyssey, pgcat, RDS
# Proxy, a provider's pooled port), or at a Unix-domain socket, where the backend
# reports no peer at all and directness is unprovable. A direct, NON-POOLED, TCP
# URL for the SAME database and the SAME schema, used ONLY by the handful of
# connections that hold a PostgreSQL SESSION advisory lock: the money-post lock
# (whose pool the daily Xero and QuickBooks accounting batches also check out of),
# the Xero payment-write lock, the WMS dispatch-sweep lock and the restore lock.
# Ordinary query traffic keeps using DATABASE_URL.
#
# WHY IT EXISTS. A session advisory lock lives on ONE backend session, and pooling
# destroys the affinity between the IMS client and that session; what then happens
# to the lock is per pooler -- reset/released with the server connection, or left
# attached to a backend handed to another client. Measured against Odyssey
# 1.5.3-rc1 in transaction-pooling mode, THAT pooler released it: two clients each
# acquired the same advisory key and each were told they held it while pg_locks
# showed neither did — which for the money-post lock means the same document can be
# paid twice. The application
# therefore REFUSES to take a session lock on a connection it cannot show reaches
# PostgreSQL directly, and this is the route past the pooler for those
# connections. Leave it unset when DATABASE_URL is already direct.
#
# It must be TCP: over a Unix-domain socket the backend reports no peer at all,
# so a pooler and a direct connection are indistinguishable and directness cannot
# be shown. Use host=127.0.0.1 rather than a socket path. A URL naming a
# different database, or resolving to a different schema, is refused rather than
# used -- and matching names are not enough either. On the first lock connection
# an advisory lock is taken through this URL and a DATABASE_URL connection is
# asked for the same key; it must be BLOCKED. A staging server or a restored
# clone carries the same database name, schema, OID and system identifier as
# production, so pointing this at one would take every lock where the work never
# happens and let the money-post lock pay the same document twice. Refused before
# any lock is taken, and re-measured for EVERY lock acquisition rather than once
# per process -- the URL strings do not change when a failover or a re-pointed
# pooler changes what they reach (o3d-2k5r r26, r27).
#
# Taking a session-lock connection is BOUNDED whether or not this is set: the
# directness proof is one statement on the lock's own socket (5s), with a 30s
# backstop over the whole acquisition, and on expiry that socket is DESTROYED and
# the caller told the lock was not taken -- a server that accepts a connection and
# then stops answering must not hang a money post, an accounting batch, a WMS
# sweep or a restore (o3d-2k5r r28).
#
# WHAT THIS DOES NOT CLAIM: it DETECTS a configuration where a session advisory
# lock demonstrably does not exclude. It does NOT make a session advisory lock a
# sufficient exclusion for money movement -- the lock still ends with its
# connection, and any check is a sample taken before the thing it licenses. The
# mechanism that would settle that is durable, fenced lease state written through
# the authoritative DATABASE_URL transaction, or -- the smaller and now preferred first step --
# connector-side idempotency on the money post itself. NEITHER IS IMPLEMENTED IN
# THIS RELEASE: o3d-ic9a (P1) is accepted and unresolved, and the window between
# the last check and the remote system accepting the request is OPEN.
# DATABASE_SESSION_LOCK_URL=postgresql://imsuser:CHANGE_ME@127.0.0.1:5432/onetwoinventory

# -----------------------------------------------------------------------------
# WOOCOMMERCE
# -----------------------------------------------------------------------------

# WooCommerce store base URL (no trailing slash).
# INSTALL-TIME SEED ONLY. scripts/provision-instance.mjs writes this into the
# wc_url setting on a fresh install and never again (insert-only), after which
# Settings -> Sync -> Connection owns the value. Editing this line on a running
# install changes nothing, and it deliberately does NOT override the setting:
# an installation repointed at a new store must not be dragged back to the old
# one by a stale .env line on its next upgrade (o3d-esha).
WC_STORE_URL=https://yourstore.com

# WooCommerce REST API consumer key & secret
# Generate at: WooCommerce → Settings → Advanced → REST API
# INSTALL-TIME SEED ONLY: these are written into the wc_consumer_key /
# wc_consumer_secret settings rows on first provision and are NOT read at runtime.
# Rotate the credential in Settings → Sync → WooCommerce → Connection; editing the
# values here afterwards has no effect (o3d-ecbj).
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to verify incoming WooCommerce webhooks
# Set the same value in: WooCommerce → Settings → Advanced → Webhooks → Secret
WC_WEBHOOK_SECRET=CHANGE_ME_random_string

# Separate secret used only by the WooCommerce helper plugin when proxying
# customer-visible invoice PDF downloads to IMS.
WC_INVOICE_PDF_SECRET=CHANGE_ME_different_random_string

# Which order statuses import, whether ingestion is webhook- or poll-driven,
# and the poll interval are NOT environment variables. They are application
# settings, edited in Settings -> Sync -> WooCommerce (wc_sync_order_statuses,
# wc_sync_interval_minutes) and read from the database by the importer.
# WC_SYNC_STATUSES, WC_USE_WEBHOOKS and WC_POLL_INTERVAL_MINUTES were
# documented here but read by nothing (o3d-tj6v): setting them changed no
# behaviour, so an operator narrowing the status filter here was not protected.
#
# The status filter applies to every import that FETCHES orders (the initial
# backfill and the poll/reconcile sweeps). It does NOT apply to the order
# webhook, which is a push from the store; the Sync page says so next to the
# checkboxes.

# -----------------------------------------------------------------------------
# SHOPIFY
# -----------------------------------------------------------------------------

# Shopify settings are stored in the app settings table. These env vars are
# only bootstrap / local-secret fallbacks where explicitly supported.

# Example: your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token from a custom/private app
SHOPIFY_ADMIN_API_ACCESS_TOKEN=

# Secret used to verify Shopify webhooks
SHOPIFY_WEBHOOK_SECRET=

# Separate secret used only for Shopify customer-visible invoice PDF proxy requests.
SHOPIFY_INVOICE_PDF_SECRET=

# -----------------------------------------------------------------------------
# MINTSOFT
# -----------------------------------------------------------------------------

# Temporary rollback flag for ASN booked-in processing. False uses direct
# /api/ASN/:id lookup; true falls back to listing all ASNs and matching locally.
MINTSOFT_USE_BULK_ASN_LOOKUP=false

# Maximum persisted Mintsoft booked-in webhook events drained per sweeper run.
MINTSOFT_WEBHOOK_SWEEPER_PAGE_SIZE=250

# -----------------------------------------------------------------------------
# CONNECTOR HTTP TRANSPORT
# -----------------------------------------------------------------------------

# Default whole-request timeout (ms) for validated WooCommerce/Mintsoft
# connector HTTP requests, including redirects. Composed with any caller
# AbortSignal. Falls back to 30000 when missing, non-numeric, fractional, or <=0.
CONNECTOR_FETCH_TIMEOUT_MS=30000

# Maximum response body bytes buffered by the validated connector HTTP client.
# Falls back to 10485760 (10 MiB) when missing, non-numeric, fractional, or <=0.
CONNECTOR_FETCH_MAX_RESPONSE_BYTES=10485760

# -----------------------------------------------------------------------------
# INTEGRATION OUTBOX RETRIES
# -----------------------------------------------------------------------------

# Retry delay is OUTBOX_RETRY_BASE_MS * 2^(attempt - 1) plus tail jitter,
# capped at OUTBOX_RETRY_MAX_MS. A 5% base-delay jitter floor applies even
# when OUTBOX_RETRY_JITTER_MS=0 to avoid synchronized retry bursts.
OUTBOX_RETRY_BASE_MS=300000
OUTBOX_RETRY_MAX_MS=3600000
OUTBOX_RETRY_JITTER_MS=30000

# -----------------------------------------------------------------------------
# XERO (UK region)
# -----------------------------------------------------------------------------

# The Xero OAuth client id/secret are NOT environment variables. Enter them in
# Settings -> Integrations -> Xero; they are stored in the settings table
# (xero_client_id / xero_client_secret, the secret encrypted at rest) and read
# from there by lib/connectors/xero/auth.ts. Connecting Xero requires the
# interactive consent round trip in the app regardless, so there is nothing an
# env copy could complete on its own (o3d-esha).

# DEPRECATED — use XERO_ALLOWED_TENANT_IDS below instead.
#
# This key spent a long time documented here and read by NOTHING, while describing itself
# as the Xero organisation id and claiming the app would populate it. It never did, and an
# operator who set it to their live organisation believed they had pinned the tenant and
# was in fact completely unprotected (o3d-9tbz).
#
# It is now honoured as a single-organisation form of XERO_ALLOWED_TENANT_IDS and enforced
# on exactly the same paths, so anyone who already had it set is genuinely protected. Do
# not use it in new installs, and do not set it ALONGSIDE XERO_ALLOWED_TENANT_IDS with a
# different value: two IDENTITY settings that disagree refuse every Xero connection rather
# than IMS guessing which of the two you meant. (Setting it alongside
# XERO_ALLOWED_TENANT_NAMES is fine — a name narrows what the id already chose.)
# XERO_TENANT_ID=

# Which Xero ORGANISATIONS this instance is allowed to connect to (o3d-9tbz).
# Blank or absent means no restriction — the control is opt-in.
#
# When set, IMS refuses at the OAuth callback (storing nothing) if the consent offers
# no allowed organisation, AND refuses to use a STORED token for a disallowed one, so
# a database restored from another environment cannot sync into its ledger. This is
# the only tenant control that survives a database reset, which is exactly how an e2e
# rig once invoiced into the live organisation.
#
# SET AN ID-BASED CONTROL ON EVERY NON-PRODUCTION INSTANCE (e2e, stage, restored copy).
# This is now ENFORCED, not advised (o3d-iaqy): an instance that has not declared itself
# production refuses to connect to Xero, and refuses to use a stored Xero token, until one
# of XERO_ALLOWED_TENANT_IDS / XERO_BLOCKED_TENANT_IDS / XERO_REQUIRE_DEMO_ORG is set.
# "Not declared production" means NODE_ENV is anything other than `production` (including
# absent), or E2E_TEST_MODE=1 — the full-chain rig serves a production build, so NODE_ENV
# reads `production` there and the e2e flag is the only signal that catches it.
# XERO_ALLOWED_TENANT_NAMES does NOT satisfy this: a rename defeats a name check.
# Production is exempt, because production is the organisation everything else is being
# kept away from. There is deliberately no switch that turns this off — every way out
# names an organisation, so performing the remedy records which ledger you chose.
# Changing any of these needs an IMS restart.
#
# The three keys are NOT equivalent. A tenantId is an identity; an organisation NAME is
# not — Xero names are neither unique ("Demo Company (UK)" is every demo company) nor
# fixed (anyone administering an organisation can rename it). So:
#
#   XERO_ALLOWED_TENANT_IDS   comma-separated tenantIds. The only key that ALLOWS.
#   XERO_BLOCKED_TENANT_IDS   comma-separated tenantIds that are refused everywhere,
#                             applied before anything else. Use this on a test rig to
#                             block the LIVE organisation: its id never changes, so
#                             unlike an allow-list it needs no maintenance when the
#                             connected test organisation is re-created.
#   XERO_ALLOWED_TENANT_NAMES comma-separated names. NARROWS the ids — it can never
#                             admit an organisation the ids exclude, and a name that
#                             matches two organisations on one consent is refused
#                             rather than used to choose between them. Matched
#                             case-insensitively; a name containing a comma cannot be
#                             expressed here at all. Never use it as the ONLY control:
#                             IMS logs a warning when it is, because a rename defeats it.
#   XERO_REQUIRE_DEMO_ORG     true/false. When true, IMS may only use a Xero DEMO
#                             organisation, proven from Xero's own IsDemoCompany flag on
#                             GET /Organisation. Identity-strength WITHOUT an id: Xero
#                             asserts it about how the organisation was created, so unlike
#                             a name it cannot be adopted by renaming, and unlike an id it
#                             survives every Demo re-creation with no edit. This is the
#                             right control for a test rig — a deny-list only fences out
#                             the organisations you thought to list, so a THIRD
#                             organisation still passes. A stored token whose demo status
#                             was never read (a restored dump, or a token from before this
#                             key) counts as UNVERIFIED and is refused; reconnect to prove
#                             it. A value that is neither yes nor no refuses every Xero
#                             connection rather than silently meaning "off".
# XERO_ALLOWED_TENANT_IDS=
# XERO_BLOCKED_TENANT_IDS=
# XERO_ALLOWED_TENANT_NAMES=Demo Company (UK)
# XERO_REQUIRE_DEMO_ORG=false

# Xero tokens are stored in the database. This legacy path is no longer used.
# XERO_TOKEN_PATH=/var/lib/onetwoinventory/xero-token.json

# -----------------------------------------------------------------------------
# QUICKBOOKS ONLINE
# -----------------------------------------------------------------------------

# QuickBooks Online OAuth app credentials. Realm / company id is stored after
# the connector is linked.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_COMPANY_ID=

# -----------------------------------------------------------------------------
# FX RATES (frankfurter.dev — free, no API key required)
# -----------------------------------------------------------------------------

# The base currency is Organisation.baseCurrency, set once in Settings ->
# Company (lib/base-currency.ts, defaulting to GBP). FX_BASE_CURRENCY was
# documented here and read by nothing, not even the installer (o3d-esha).

# FX rates are fetched via cron job hitting /api/cron/fx-rates daily at 06:00

# -----------------------------------------------------------------------------
# AI HS-CODE CLASSIFICATION (optional — Anthropic Claude)
# -----------------------------------------------------------------------------

# Anthropic API key for the HS/CN-code classifier (lib/trade/hs-classifier.ts).
# When unset, the classifier falls back to deterministic keyword rules — it never
# hard-fails. Uses Claude Sonnet 4.6 as the workhorse, escalating to Opus 4.8 on
# ambiguous/non-declarable results.
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# SMTP (transactional email — PO/RFQ emails)
# -----------------------------------------------------------------------------
#
# INSTALL-TIME SEED ONLY. These are read once by scripts/provision-instance.mjs,
# which writes them into the settings table (email_smtp_*). At runtime
# lib/mailer.ts reads those settings and never looks at the environment, so
# editing these values on a running install changes nothing — change mail
# settings in Settings -> Email instead (o3d-esha).

SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587

# Encryption: tls | ssl | none
SMTP_SECURE=tls

SMTP_USER=your@email.com
# Spelled SMTP_PASS, not SMTP_PASSWORD: SMTP_PASS is the name every consumer
# reads (scripts/provision-instance.mjs) and every other writer sets.
SMTP_PASS=CHANGE_ME

# From address shown on outgoing emails
SMTP_FROM_EMAIL=ims@yourdomain.com
SMTP_FROM_NAME=onetwoInventory
SMTP_REPLY_TO=

# Directory to store database backups locally before download/remote upload
BACKUP_DIR=/var/lib/onetwoinventory/backups

# In NODE_ENV=production, these kill switches must be true for the restore
# route to function; they have no effect in non-production environments. Enable
# the base flag only during a supervised restore window; enable the upload flag
# only when restoring from an uploaded SQL file rather than an existing
# server-side backup.
ALLOW_DATABASE_RESTORE=false
ALLOW_DATABASE_RESTORE_UPLOAD=false

# Maximum uploaded SQL restore file size in bytes. Defaults to 52428800 (50 MiB)
# when unset. Uploaded restores must also provide the matching .manifest.json
# sidecar generated with the backup.
DATABASE_RESTORE_MAX_FILE_BYTES=52428800

# -----------------------------------------------------------------------------
# FILE UPLOADS (CSV imports)
# -----------------------------------------------------------------------------

# Upload size caps are per-kind constants in code, not one configurable number:
# 10 MB CSV import (app/actions/import.ts), 2 MB avatar / 5 MB logo / 20 MB
# supplier invoice (lib/security/upload-validation.ts). UPLOAD_MAX_SIZE_MB was
# documented here and read by nothing, so lowering it as a DoS mitigation
# achieved nothing (o3d-esha).

# Persistent private upload root for files served only through authenticated
# routes, such as supplier invoice PDFs. Local default: ./uploads
UPLOAD_STORAGE_DIR=/var/lib/onetwoinventory/uploads

# Persistent public-asset upload root for branding and avatars. Assets are still
# served through API routes; this directory does not need to sit under ./public.
# Local default: ./public/uploads
PUBLIC_UPLOAD_STORAGE_DIR=/var/lib/onetwoinventory/public-uploads

# Invoice PDF malware scan hook. disabled preserves existing upload behavior.
# command mode writes PDFs to quarantine first, runs the configured scanner, and
# moves only clean files to final storage. Use FILE_SCAN_COMMAND_ARGV for exact
# JSON argv; otherwise use FILE_SCAN_COMMAND with {file} where the quarantined
# PDF path should be inserted. IMS appends the path if {file} is omitted.
# Scanner subprocesses receive only FILE_SCAN_ENV_ALLOWLIST variables.
FILE_SCAN_MODE=disabled
FILE_SCAN_COMMAND_ARGV=
FILE_SCAN_COMMAND=
FILE_SCAN_NAME=
FILE_SCAN_ENV_ALLOWLIST=PATH,HOME,TMPDIR,TEMP,TMP,LANG,LC_ALL
FILE_SCAN_TIMEOUT_MS=30000 # 30s default; raise this for large PDFs or busy scanners.

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
#
# There is no logger module and no log configuration. Output is plain console.*
# at fixed severity. LOG_LEVEL and LOG_FORMAT were documented here and read by
# nothing (o3d-esha).
