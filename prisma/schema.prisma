// MANUFACTURING
// ---------------------------------------------------------------------------

/// Bill of Materials — one BOM per finished product
model Bom {
  id          String    @id @default(cuid())
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       BomItem[]
  productionOrders ProductionOrder[]

  @@map("boms")
}

model BomItem {
  id            String  @id @default(cuid())
  bomId         String
  parentProductId String // the finished good produced
  componentProductId String
  qty           Decimal @db.Decimal(12, 4)
  notes         String?
  sortOrder     Int     @default(0)

  bom           Bom     @relation(fields: [bomId], references: [id])
  parentProduct Product @relation("BomParent", fields: [parentProductId], references: [id])
  component     Product @relation("BomComponent", fields: [componentProductId], references: [id])

  @@index([bomId])
  @@index([parentProductId])
  @@index([componentProductId])
  @@map("bom_items")
}

/// Virtual kit — not physically assembled; components deducted on sale
model Kit {
  id          String    @id @default(cuid())
  name        String
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items       KitItem[]

  @@map("kits")
}

model KitItem {
  id              String  @id @default(cuid())
  kitId           String
  parentProductId String  // the kit product SKU
  componentProductId String
  qty             Decimal @db.Decimal(12, 4)
  sortOrder       Int     @default(0)

  kit             Kit     @relation(fields: [kitId], references: [id])
  parentProduct   Product @relation("KitParent", fields: [parentProductId], references: [id])
  component       Product @relation("KitItemComponent", fields: [componentProductId], references: [id])

  @@index([kitId])
  @@index([parentProductId])
  @@index([componentProductId])
  @@map("kit_items")
}

model ProductionOrder {
  id              String                @id @default(cuid())
  reference       String                @unique
  orderType       ProductionOrderType   @default(ASSEMBLY)
  bomId           String
  outputProductId String               // finished good
  warehouseId     String               // produced in / stock added to
  manufacturerId  String?              // optional: supplier acting as manufacturer
  qtyPlanned      Decimal              @db.Decimal(12, 4)
  qtyProduced     Decimal              @db.Decimal(12, 4) @default(0)
  status          ProductionOrderStatus @default(DRAFT)
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Order currency + FX for foreign-currency manufacturing costs (labour
  // priced in a non-base currency, etc.). Base totals on cost lines use
  // this rate. Defaults to base currency / 1.0.
  currency        String               @default("GBP")
  fxRateToBase    Decimal              @db.Decimal(18, 8) @default(1)

  // audit-H6: frozen component requirements captured at the IN_PROGRESS
  // transition — [{ componentId, qty }] (qty per output unit at snapshot time).
  // Consumption (COMPLETED) and release (CANCELLED) read this, never the live
  // BOM, so editing the product's components mid-production cannot strand a
  // reservation or change what is consumed/recovered. Null for orders that were
  // never started (direct completion falls back to the live BOM).
  componentSnapshot Json?
  // audit-77d1: set when a DISASSEMBLY completion fell back to equal-split overhead
  // (recovered cost layers lacked source lines), so the MO detail can flag that the
  // component cost split was approximate.
  usedDisassemblyFallback Boolean @default(false)

  bom             Bom                  @relation(fields: [bomId], references: [id])
  outputProduct   Product              @relation(fields: [outputProductId], references: [id])
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id])
  manufacturer    Supplier?            @relation(fields: [manufacturerId], references: [id])
  manufacturingCostLines ManufacturingCostLine[]
  costLayers      CostLayer[]

  @@index([status])
  @@index([createdAt])
  @@map("production_orders")
}

/// Per-run overheads applied to a production order (labour, machine time,
/// utilities, etc.). Sum is spread equally across qtyProduced and folded
/// into the output cost layer on assembly (or the recovered-component
/// layers on disassembly). Each line optionally overrides the default
/// manufacturing-overhead account from Settings.
model ManufacturingCostLine {
  id                String   @id @default(cuid())
  productionOrderId String
  description       String
  amountForeign     Decimal  @db.Decimal(18, 4)
  amountBase        Decimal  @db.Decimal(18, 4)
  accountCode       String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@index([productionOrderId])
  @@map("manufacturing_cost_lines")
}

// ---------------------------------------------------------------------------
// XERO SYNC
// ---------------------------------------------------------------------------

model AccountingAccount {
  id                String   @id @default(cuid())
  connector         String   @default("xero")
  externalAccountId String   // Connector account ID
  code              String?
  name              String
  type              String   // EXPENSE, REVENUE, ASSET, etc.
  taxType           String?
  active            Boolean  @default(true)
  syncedAt          DateTime @default(now())

  @@unique([connector, externalAccountId])
  @@index([connector, active, code])
  @@map("accounting_accounts")
}

model AccountingAccountBalanceSnapshot {
  id                String   @id @default(cuid())
  connector         String   @default("xero")
  externalAccountId String
  accountCode       String?
  accountName       String
  balanceDate       DateTime @db.Date
  currency          String
  amountForeign     Decimal  @db.Decimal(18, 6)
  amountBase        Decimal  @db.Decimal(18, 6)
  sourcePayloadRef  String?
  syncRunId         String?
  fetchedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([connector, externalAccountId, balanceDate, currency], map: "accounting_account_balance_snapshots_connector_externalAcco_key")
  @@index([connector, accountCode, balanceDate], map: "accounting_account_balance_snapshots_connector_accountCode__idx")
  @@index([connector, balanceDate])
  @@map("accounting_account_balance_snapshots")
}

model AccountingSyncLog {
  id                    String               @id @default(cuid())
  connector             String               @default("xero")
  type                  AccountingSyncType
  status                AccountingSyncStatus @default(PENDING)
  referenceType         String // "PurchaseOrder", "CogsEntry", "SalesOrder", etc.
  referenceId           String
  externalTransactionId String?
  payload               Json? // what was sent
  errorMessage          String?
  retryCount            Int                  @default(0)
  /// o3d-e2mz: the identity of the CURRENT attempt on this row. Bumped by the processor every time
  /// it claims the row (PENDING/stale-PROCESSING -> PROCESSING), and by any operator decision that
  /// terminalises it. Status cannot identify an attempt: every path returns the row to a status it
  /// already held (retryFailed* drives FAILED -> PENDING -> FAILED, a stale reclaim drives
  /// PROCESSING -> PROCESSING), and retryCount is reset to 0 by retryFailed*, so neither is
  /// monotonic. This is, so a decision taken about what was read can compare-and-swap on it and be
  /// refused when the row has moved on to a different attempt.
  ///
  /// 0 means "no processor that participates in the fence has ever claimed this row" — the claim
  /// bump makes the first attempt 1. A non-PENDING row still at 0 therefore cannot be fenced at all
  /// and must be refused rather than guessed at (see lib/domain/accounting/sync-log-attempt.ts).
  attemptRevision       Int                  @default(0) @map("attempt_revision")
  /// o3d-nf9i r3 — HOW this row's terminal status was reached, when it was not reached by the
  /// connector. NULL is the ordinary case: the status is whatever the processor's own writeback
  /// wrote, so it is a CONNECTOR CONFIRMATION. 'OPERATOR_ASSERTION' means a human asserted the
  /// outcome (app/actions/accounting-settlement.ts) and IMS verified NOTHING about it — no call was
  /// made, no figure was compared, only a document id was typed in.
  ///
  /// It exists because a verdict has to carry its basis. Without this column a settled row is
  /// byte-identical to a connector-confirmed one, and every reader that asks "did this post?" —
  /// most importantly lib/domain/accounting/settlement-status.ts, which then compares the amount
  /// IMS INTENDED to send against the document total — answers as if the ledger had confirmed it.
  /// Xero will accept a payment for less than the invoice as a PART payment, so a matching pair of
  /// local numbers is not evidence of anything on an asserted row. Readers must fail closed on it.
  settlementBasis       String?              @map("settlement_basis")
  processingStartedAt   DateTime?
  syncedAt              DateTime?
  // o3d-clxw r5 finding 1: the same instant as `syncedAt`, written by the same statement from a
  // SINGLE evaluation of `clock_timestamp()` (stampSyncedAtFromDatabaseClock). The payment poller's
  // reversal fence accepts a registration as ordered against the ledger read only when this column
  // is present AND equal to `syncedAt` — so a row whose `syncedAt` came from an application host's
  // wall clock (an old build during a deploy, either creating the row or rewriting it) is
  // DISTINGUISHABLE from one the database stamped, and withholds instead of deciding. NULL is not a
  // missing value here, it is "this row's completion time cannot be ordered against anything", and
  // it is never backfilled: copying `syncedAt` into it would be the database vouching for a stamp it
  // did not produce. See the migration for the full argument.
  //
  // r6 finding 1: the equality is a rule the DATABASE enforces, not one the reader can check. A
  // trigger in the same migration clears this column whenever a statement changes `status`,
  // `syncedAt`, `externalTransactionId` or `processingStartedAt` without minting a new marker in the
  // same statement, and refuses one supplied by an INSERT — so a writer that does not know about the
  // scheme (the previous release, a script, psql) destroys provenance rather than inheriting it,
  // whatever millisecond it happens to land on. Triggers are invisible to this schema; the migration
  // is where the rule lives.
  syncedAtDatabaseClock DateTime?
  createdAt             DateTime             @default(now())
  // o3d-9kek: when the back-reference repair sweep last REACHED A VERDICT on this row
  // (its document is linked, or the row can never be attributed automatically). NULL =
  // never examined. The sweep's candidate filter is `backReferenceCheckedAt: null`, so a
  // row it has settled leaves the candidate set for good instead of being re-selected and
  // re-probed on every cron cycle — which is what let 200 ordinary historical rows fill
  // the bounded page and starve every newer broken row behind them.
  //
  // Deliberately NOT stamped on a transient failure (probe threw, repair threw, follow-up
  // enqueue deferred), NOR on an ambiguous legacy PurchaseOrder-keyed row: a competing sibling
  // can be cancelled or post, several unlinked bills can shrink to one, and the manual link the
  // warning asks for changes the answer. Those rows must stay eligible so the next sweep
  // retries them.
  backReferenceCheckedAt DateTime?
  // o3d-9kek: when the sweep last REPORTED that this row's bill cannot be attributed. A
  // DEFERRAL, not a verdict: the candidate query skips the row until one recheck interval has
  // passed, then looks again. Ambiguous rows must stay eligible (the ambiguity can clear), but
  // fully eligible meant re-probing and re-warning on every cron cycle, and a backlog of them
  // would re-fill the head of the scan and starve newer rows — the same starvation, one column
  // over. The repeat warning carries the previous timestamp so a row nobody ever links by hand
  // cannot go quiet.
  backReferenceAmbiguousLoggedAt DateTime?
  // o3d-9kek r3 finding 3: when this row's full payload was compacted to an attribution-only
  // TOMBSTONE because it outlived the retention period while still unresolved. Tombstones keep the
  // (connector, type, status, referenceType, referenceId, externalTransactionId) evidence that stops
  // an ambiguity silently becoming a certainty, but drop the payload and errorMessage, which are
  // where the customer names, emails, addresses and financial lines live. (An earlier revision of
  // this comment listed a `provenance` column: that was part of the per-realm namespacing work,
  // which was tried and REVERTED — this model has no such column. See o3d-gt8r / o3d-s36z.)
  //
  // r4 finding 3: a tombstone IS still a sweep candidate. The columns the id write reads
  // all survive compaction, so an ambiguity that clears after the retention horizon — or a
  // back-reference that was merely failing transiently at the cutoff — is still repaired. Only the
  // payload-dependent FOLLOW-UPS (PDF, payment, attachment) are unrecoverable, and the sweep
  // discards those under an explicit terminal policy with a warning. Excluding the whole row, which
  // an earlier revision did, let retention permanently retire repairable work.
  backReferenceEvidenceCompactedAt DateTime?
  // o3d-9kek Codex r9 finding 1: this row's back-reference is written, but the FOLLOW-UPS it owes
  // (invoice PDF, payment registration, bill attachment) have not been enqueued yet. Written BEFORE
  // the repair touches anything and cleared only when the enqueue has actually succeeded.
  //
  // WHY A COLUMN AND NOT `status`. "Follow-ups still owed" used to be inferred from `status =
  // FAILED`, which is true for a Xero row whose retries exhausted — but NOT for the crash-after-post
  // row this sweep primarily exists for: that one is SYNCED with no back-reference, and once the
  // sweep has written the link a TRANSIENT enqueue failure left nothing behind to say the follow-ups
  // never ran. The next sweep then saw a linked SYNCED row, called it reconciled and stamped
  // backReferenceCheckedAt, permanently discarding the payment or PDF. A transient failure is not a
  // verdict; this column is what keeps it from becoming one.
  //
  // Flipping such a row to FAILED instead was rejected: queueXeroSync/queueQuickBooksSync dedupe new
  // enqueues on `status in (PENDING, PROCESSING, SYNCED)`, so a row moved out of SYNCED stops
  // suppressing its own re-enqueue and the document posts to the ledger a SECOND time.
  //
  // Not a candidate-query predicate: an unstamped row is a candidate already. It only widens the
  // "back-reference done, follow-ups outstanding" pass that used to be FAILED-only.
  backReferenceFollowUpsPendingAt DateTime?
  // o3d-k26m.5: the invoice number THIS row SET OUT TO POST under, written immediately before the
  // request left and only once a live lookup had said the ledger did not hold that number yet.
  //
  // IT IS NOT A CLAIM OF OWNERSHIP, and round 2's version of this column was (Codex round 3). The
  // inference it carried — "nobody held this number when the row set out, somebody holds it now,
  // therefore the holder is ours" — cannot identify a holder: it is a fact about the LOOKUP's
  // moment. And it would only ever be consulted when the number IS held, which — once xeroom is
  // removed and the only remaining holders are the ~14,415 documents it left behind — means the
  // lookup MISSED one. So the licence would fire exactly where the fence has already failed,
  // repeating the overwrite and removing the refusal that would have exposed it. It licenses
  // nothing.
  //
  // Two jobs remain, both honest:
  //   * it is written BEFORE an irreversible remote write, and a failure to write it refuses the
  //     post — a create whose local record cannot be written is a create whose OUTCOME cannot be
  //     recorded either, which is precisely the lost-response state;
  //   * a later refusal can say "this row already set out under this number", which is the
  //     difference between a refusal an operator can diagnose and one they cannot.
  //
  // The NUMBER is stored, not a bare flag, so a row whose payload number later changes cannot be
  // described with an attempt taken for a different one. Scope is the row, deliberately: a freshly
  // enqueued row for the same order does not inherit it.
  attemptedInvoiceNumber   String?   @map("attempted_invoice_number")
  attemptedInvoiceNumberAt DateTime? @map("attempted_invoice_number_at")

  // o3d-o97 r6 — THE ONE FACT THAT MAKES A CANCELLED ROW EVIDENCE ABOUT POUNDS.
  //
  // r5 established, in three places, that `status = CANCELLED` proves nothing: it records that a
  // sweep or an operator ABANDONED the row, and the processors POST BEFORE persisting SYNCED and the
  // external id, so an abandoned row may already have reached the ledger. That left
  // `recreateMissingDailyBatchLogs` — which re-raises a journal when it can see no live log — reading
  // the same status as proof that the batch MUST be posted again. Two readers, opposite conclusions,
  // one fact; and the recreate side's conclusion costs a DUPLICATE journal in a real ledger.
  //
  // The reconciliation is not to pick a winner but to record the thing the status was standing in
  // for. ONE canceller can prove there was no remote call: the cross-connector orphan sweep
  // (`cancelOrphanedRowsUnderLock`) matches `status = PENDING` only, and its own comment states why
  // — "A PENDING row is provably PRE-CALL: nothing was sent". That writer, and only that writer,
  // sets this to true in the same UPDATE as the status.
  //
  //   true    nothing was ever sent for this row. Its journal is NOT in any ledger, so recreate may
  //           rebuild it and a relief/debit record naming it moved zero pounds.
  //   null    everything else — every other canceller, every pre-r6 cancelled row, and every row
  //           that was never cancelled at all. NOT "a call was made": "not on record", which every
  //           reader treats as unproved, exactly as it treats a null attribution column.
  //
  // Nullable, no DEFAULT and NOT BACKFILLED for the same reason as the o97 attribution columns: a
  // default is a value, and `false` would assert that a historical cancelled row HAD made its call —
  // manufacturing the confidence this column exists to stop being assumed. It is never written on
  // any path that posts, so it can only ever be set by a writer that knows the negative.
  abandonedBeforeRemoteCall Boolean? @map("abandoned_before_remote_call")

  // Polymorphic reference: use referenceType + referenceId for application-level lookups.
  // No FK constraints — referenceId may point to PurchaseOrder, SalesOrder, etc. based on referenceType.

  @@index([connector, referenceType, referenceId])
  @@index([connector, status, createdAt])
  @@index([connector, status, processingStartedAt])
  // The sweep's candidate scan: one connector, never-checked rows, oldest first.
  @@index([connector, backReferenceCheckedAt, createdAt], map: "accounting_sync_logs_backref_sweep_idx")
  @@map("accounting_sync_logs")
}

model AccountingEvent {
  id               String   @id @default(cuid())
  type             String
  sourceEntityType String
  sourceEntityId   String
  businessDate     DateTime
  status           String   @default("PENDING")
  idempotencyKey   String   @unique
  linesJson        Json
  currency         String
  externalSystem   String?
  externalId       String?
  // o3d-cvj9 r3: the EXTERNAL system's own revision stamp for the document this event posted —
  // Xero's `Invoice.UpdatedDateUTC`, taken from the response to the very write we made. It is the
  // only ordering that is true of the order in which edits were APPLIED to the document, so it is
  // what decides which of two competing revisions may hold `externalId`. Null means "not
  // established" (the connector returned none, the row predates this column, or an administrative
  // backfill wrote it) and is never guessed at — see resolveDocumentRevisionOrder.
  externalRevisionAt DateTime?
  // o3d-cvj9 r4/r5: on what basis this row can be ordered against another revision of the same
  // document when there is no `externalRevisionAt` to compare. A CATEGORY, never a clock. Two
  // values are written, both by the code that made (or repaired) the write, and both cleared the
  // moment a live write records a real stamp on the row:
  //   historical_backfill_repair — the administrative backfill repaired a write its sync log had
  //     already recorded complete, and that row TOOK the document id. See
  //     HISTORICAL_BACKFILL_REVISION_ORDER_BASIS.
  //   live_write_unstamped — the connector wrote in this attempt and returned no readable stamp, so
  //     the wiped `externalRevisionAt` must not be read as "this row never wrote". See
  //     LIVE_UNSTAMPED_WRITE_REVISION_ORDER_BASIS.
  // o3d-cvj9 r6: NEITHER value orders its row against another write on its own — the first says
  // nothing about when the arriving write landed, and the second says a write happened, not when and
  // not whether it was a re-post. Both feed rules that ASSUME an order and return it labelled as an
  // assumption, which the live mirror acts on (and audits) and the backfill declines.
  // Null everywhere else — including on the enqueue-time row of every live revision.
  revisionOrderBasis String?
  reversalOfId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reversalOf       AccountingEvent?  @relation("AccountingEventReversal", fields: [reversalOfId], references: [id])
  reversals        AccountingEvent[] @relation("AccountingEventReversal")
  logs             AccountingEventLog[]

  @@index([sourceEntityType, sourceEntityId])
  @@index([status, businessDate])
  @@unique([externalSystem, externalId])
  @@index([reversalOfId])
  @@map("accounting_events")
}

model AccountingEventLog {
  id                String   @id @default(cuid())
  accountingEventId String
  action            String
  message           String?
  metadata          Json?
  createdAt         DateTime @default(now())

  accountingEvent   AccountingEvent @relation(fields: [accountingEventId], references: [id], onDelete: Cascade)

  @@index([accountingEventId, createdAt])
  // o3d-cvj9 r7: the accounting reconciliation report selects this table by ACTION — the handovers
  // the live mirror made on an order nothing established (`superseded_by_assumed_order`) — bounded
  // by its lookback. Without this index that is a scan of the largest audit table in the schema on
  // every run. The existing index is keyed by event, which that query has no value for: the whole
  // point is to find the entries without knowing which events they hang off.
  @@index([action, createdAt])
  @@map("accounting_event_logs")
}

model AccountingReconciliationRun {
