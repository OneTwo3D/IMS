/// One-time auth tokens (TOTP challenge, passkey challenge, etc.)
/// Replaces the in-memory token store with a single-row lookup that survives
/// next start restarts.
model OneTimeToken {
  key       String   @id            // e.g. "passkey_challenge:...", "totp_verify:..."
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("one_time_tokens")
}

// ---------------------------------------------------------------------------
// ORDER ALLOCATIONS & SHIPMENTS
// ---------------------------------------------------------------------------

/// Per-line warehouse allocation for sales orders
model OrderAllocation {
  id          String   @id @default(cuid())
  orderId     String
  lineId      String
  productId   String
  warehouseId String
  qty         Decimal  @db.Decimal(12, 4)
  /// o3d-4kfh r6: `Product.fulfillmentGraphVersion` of the ORDER LINE's product, read in the same
  /// statement as the component graph this row was expanded from. Commitment and dispatch refuse
  /// when it no longer matches the product's current version — see the note on Product.
  fulfillmentGraphVersion Int @default(0) @map("fulfillment_graph_version")
  costLayerSnapshot Json?
  // o3d-o97 r3: THE POUNDS GROUP A2 DEBITED FOR THIS ROW, written in the same transaction as the
  // order's stamp. `costLayerSnapshot` beside it is the row's PINNED LAYERS, and landed-cost
  // revaluation rewrites their unitCostBase in place (updateSnapshotsForCostLayerChange) — so
  // valuing a partial refund's reversal from the snapshot reverses today's price for a debit
  // raised at yesterday's. This is the posted basis, and `qty` divides it into a posted unit cost
  // that no downstream revaluation can move. NULL on rows created after A2 stamped the order (the
  // rebalancer re-pins), where no posting was raised for the row at all.
  allocationBatchAmount Decimal? @db.Decimal(18, 4) @map("accounting_allocation_batch_amount")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  line        SalesOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([lineId, warehouseId, productId])
  @@index([orderId])
  @@index([productId, warehouseId])
  @@index([costLayerSnapshot(ops: JsonbOps)], type: Gin, map: "order_allocations_costLayerSnapshot_gin_idx")
  @@map("order_allocations")
}

/// A shipment groups allocated lines from one warehouse
model Shipment {
  id              String         @id @default(cuid())
  orderId         String
  warehouseId     String
  status          ShipmentStatus @default(PENDING)
  trackingNumber  String?
  shippingService String?
  shippedAt       DateTime?

  // Accounting sub-ledger tracking
  shipmentJournalDate     DateTime?              @map("accounting_shipment_journal_date")
  cogsBatchAmount         Decimal?  @db.Decimal(18, 4) @map("accounting_cogs_batch_amount")
  revenueRecognizedAmount Decimal?  @db.Decimal(18, 4) @map("accounting_revenue_recognized_amount")
  // o3d-0qoo: exact Group B batch referenceId this shipment was staged into. See the same
  // pair of columns on SalesOrder for why identity is persisted rather than re-derived.
  shipmentJournalBatchRef String?                @map("accounting_shipment_journal_batch_ref")
  // o3d-o97 r3: THE CR ALLOCATED INVENTORY THIS SHIPMENT'S GROUP B JOURNAL RAISED, written in the
  // same UPDATE as `shipmentJournalDate`. Group B posts DR COGS / CR Allocated for exactly this
  // shipment's dispatch COGS, so this is the relief the allocated contra received.
  //
  // Deliberately NOT `cogsBatchAmount` beside it, which landed-cost revaluation REWRITES IN PLACE
  // (refreshShipmentCogsForCostLayerChange) while posting only to COGS/Inventory — the Allocated
  // relief never moves. And deliberately not re-derived from the CogsEntry dispatch rows either:
  // those are HARD-DELETED by `retention_stock_movements_months`, after which the derivation
  // silently returns the CURRENT layer cost, or zero for a shipment with no stored line snapshot.
  // A record that survives the crash and then expires is not evidence; retention deletes stock
  // movements and sync logs, it does not delete shipments.
  allocatedReliefAmount   Decimal?  @db.Decimal(18, 4) @map("accounting_allocated_relief_amount")
  // o3d-o97 r4 — AND WHETHER THAT RELIEF WAS EVER RAISED, AND WHERE.
  //
  // r3 recorded the amount alone, which is the very inference it had just destroyed on the A2 side
  // one field along: `allocatedReliefAmount` above is written for EVERY shipment the batch stamps,
  // while the CR Allocated Inventory line only exists when the window's ROUNDED COGS total is
  // positive — and even then the log is created PENDING, in a transaction that ends before the
  // remote call, so it can finish CANCELLED with nothing credited anywhere.
  //
  // Reading a queued (or never-raised) figure as relief SHRINKS the open balance, so the refund
  // reverses less than the account holds and a FULL refund — which closes both batch windows for
  // ever — strands the difference permanently. These three make the amount resolvable:
  //
  //   syncLogId   the AccountingSyncLog row's own id, null unless that row was created AND
  //               carried a CR Allocated Inventory line. Resolving it reads the row's STATUS,
  //               so queued is never read as posted.
  //   connector   which LEDGER the credit was raised into.
  //   accountCode the exact Allocated Inventory account it credited.
  //
  // NULL together on shipments journaled before these columns existed, where
  // `allocatedReliefAmount` is also null and the CogsEntry derivation (which refuses rather than
  // degrades) still answers.
  allocatedReliefSyncLogId   String? @map("accounting_allocated_relief_sync_log_id")
  allocatedReliefConnector   String? @map("accounting_allocated_relief_connector")
  allocatedReliefAccountCode String? @map("accounting_allocated_relief_account_code")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id])
  lines           ShipmentLine[]

  @@index([orderId])
  @@index([shipmentJournalBatchRef], map: "shipments_shipment_journal_batch_ref_idx")
  @@map("shipments")
}

/// Line items within a shipment
model ShipmentLine {
  id          String   @id @default(cuid())
  shipmentId  String
  lineId      String
  productId   String
  qty         Decimal  @db.Decimal(12, 4)
  costLayerSnapshot Json?

  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  line        SalesOrderLine @relation(fields: [lineId], references: [id])
  product     Product        @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([costLayerSnapshot(ops: JsonbOps)], type: Gin, map: "shipment_lines_costLayerSnapshot_gin_idx")
  @@map("shipment_lines")
}

/// o3d-d82p: an unlinked WooCommerce order seen in a withdrawal status.
///
/// The import guard refuses to CREATE such an order — doing so would allocate
/// stock for goods the customer has asked to withdraw. But the webhook inbox
/// does not guarantee per-order ordering, so a STALE `order.created` carrying
/// `processing` can arrive afterwards and sail past a guard that only inspects
/// the payload in front of it. This row is the durable memory of the refusal.
///
/// Cleared only once the live storefront status proves the request was
/// rejected, at which point the order imports normally.
model WcWithdrawalSuppression {
  connector       String
  externalOrderId String
  /// The withdrawal status observed when the import was refused.
  wcStatus        String
  createdAt       DateTime @default(now())
  lastCheckedAt   DateTime?
  /// Bumped on every re-record. The resolver reads the live storefront status
  /// and then deletes this row; without a revision, a NEWER withdrawal landing
  /// in that gap is deleted by the stale worker and the order imports unmarked.
  /// The delete is conditional on the revision observed before the live fetch.
  revision        Int      @default(0)
  /// Lease held by the worker currently acting on this withdrawal. The row
  /// STAYS while claimed, so it keeps suppressing imports — deleting it to
  /// claim it opened a window where neither the claimant nor anyone else
  /// treated the order as withdrawn. Self-heals: a lease older than
  /// SUPPRESSION_LEASE_MS is reclaimable, so a crashed worker cannot pin it.
  claimToken      String?
  claimedAt       DateTime?
  /// When the storefront was FIRST observed to have rejected this withdrawal.
  /// The row is not retired on that single observation: a resubmission landing
  /// between the live read and the delete, whose webhook is then missed, would
  /// be erased along with the only durable signal — and the WMS create path
  /// checks only the IMS markers, so it could push the order. The tombstone is
  /// retired once rejection has held across SUPPRESSION_QUIESCENCE_MS, which
  /// the by-ID sweep keeps re-verifying.
  clearPendingSince DateTime?
  /// Soft retirement. Deleting outright ended the fulfilment fence at the same
  /// instant as the decision to end it, so a resubmission landing between the
  /// final live read and the delete — with its webhook missed — left a
  /// warehouse-eligible order with no marker and no row. The row survives for
  /// SUPPRESSION_RETIRE_GRACE_MS after retirement: the WMS create claim keeps
  /// fencing on it, and the by-ID sweep keeps re-verifying it, so a
  /// resubmission in that gap is still found. Hard-deleted after the grace.
  retiredAt       DateTime?
  /// A retired row is proved-safe only for a short, explicit window, set by a
  /// by-ID WooCommerce read taken as part of the WMS create-claim protocol.
  /// The row is never auto-deleted: any external read followed by a local
  /// delete is time-of-check-to-time-of-use, so the check has to sit next to
  /// the push instead of ending monitoring permanently.
  /// SINGLE-USE proof, not a cache. A time window would let a second attempt
  /// reuse another worker's read, so this token is consumed by the claim that
  /// it authorised; any other attempt must take its own live read.
  pushProofToken  String?
  verifiedSafeUntil DateTime?

  @@id([connector, externalOrderId])
  @@map("wc_withdrawal_suppressions")
}
