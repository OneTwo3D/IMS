enum WmsMutationDirection {
  OUTBOUND
  INBOUND
}

enum WmsMutationOutcome {
  SUCCEEDED
  FAILED
}

/// q66in.4.6: audit-grade timeline of connector mutations — one row per
/// IMS↔WMS state change, with operational before/after images. Payloads are
/// built at the call sites from operational fields only (states, ids, SKUs,
/// quantities, totals) and pass through a PII scrub as defense-in-depth —
/// never full order/customer dumps. Purged by the activity-cleanup cron after
/// the configured retention.
model WmsMutationEvent {
  id          String               @id @default(cuid())
  connector   String
  direction   WmsMutationDirection
  /// e.g. order_create, order_update, order_hold, order_cancel, order_release,
  /// order_comment, asn_create, product_upsert, bundle_upsert, align_up,
  /// align_down, booked_in_receipt, dispatch_applied, return_inbox
  action      String
  outcome     WmsMutationOutcome
  /// IMS entity the mutation is about: SALES_ORDER, PRODUCT, ASN, STOCK_LEVEL,
  /// SHIPMENT, RETURN — free string, matches the timeline UI filter.
  entityType  String
  entityId    String?
  /// WMS-side identifier (external order/ASN/product id) when known.
  externalId  String?
  summary     String
  before      Json?
  after       Json?
  error       String?
  /// Correlates to a WmsSyncJob run when the mutation happened inside one.
  jobId       String?
  triggeredBy String?
  createdAt   DateTime             @default(now())

  @@index([createdAt])
  @@index([connector, createdAt])
  @@index([entityType, entityId])
  @@index([entityId])
  @@index([externalId])
  @@index([action, createdAt])
  @@map("wms_mutation_events")
}

model WmsStockSnapshot {
  id           String   @id @default(cuid())
  connector    String
  warehouseId  String
  productId    String
  externalQty  Decimal  @db.Decimal(12, 4)
  imsQtyAtSync Decimal  @db.Decimal(12, 4)
  lastSeenAt   DateTime
  updatedAt    DateTime @updatedAt

  warehouse    Warehouse @relation("WmsStockSnapshotWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)
  product      Product   @relation("WmsStockSnapshotProduct", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([connector, warehouseId, productId])
  @@index([warehouseId, productId])
  @@map("wms_stock_snapshots")
}

/// q66in.4.4: durable ORDER-level reconcile finding. The capped daily sweep can
/// never produce a complete snapshot, so findings persist as OPEN rows —
/// upserted when detected, resolved only when THAT order re-verifies clean (or
/// the drift predicate no longer holds). One OPEN row per (order, category),
/// enforced by a partial unique index in SQL.
model WmsOrderDiscrepancy {
  id                  String    @id @default(cuid())
  connector           String
  orderId             String
  category            String
  status              String    @default("OPEN")
  detail              String?
  externalOrderNumber String?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  resolvedAt          DateTime?

  order               SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, category])
  @@index([orderId])
  @@map("wms_order_discrepancies")
}

model WmsStockDiscrepancy {
  id             String               @id @default(cuid())
  connector      String
  warehouseId    String
  productId      String?
  sku            String?
  category       WmsDiscrepancyCategory
  /// Only one OPEN discrepancy per connector/warehouse/category/product-or-sku
  /// is allowed. This is enforced with partial unique SQL indexes because
  /// Prisma cannot express filtered uniqueness in the schema DSL.
  status         WmsDiscrepancyStatus @default(OPEN)
  imsValue       String?
  wmsValue       String?
  delta          Decimal?             @db.Decimal(12, 4)
  message        String?
  detectionCount Int                  @default(1)
  firstSeenAt    DateTime             @default(now())
  lastSeenAt     DateTime             @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedNote   String?

  warehouse      Warehouse            @relation("WmsStockDiscrepancyWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  product        Product?             @relation("WmsStockDiscrepancyProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([connector, status, category])
  @@index([warehouseId, status])
  @@index([productId])
  @@map("wms_stock_discrepancies")
}

model WmsInboundReceiptEvent {
  id                 String   @id @default(cuid())
  connector          String
  externalEventId    String
  externalAsnId      String?
  payload            Json
  processedAt        DateTime?
  processingStatus   String   @default("PENDING")
  processingAttempts Int      @default(0)
  nextRetryAt        DateTime?
  deadLetteredAt     DateTime?
  lastError          String?
  /// Full dry-run object captured when the event entered REQUIRES_REVIEW state.
  /// Stored as JSONB; dashboard queries show a capped event list and keep detailed inspection on the review API.
  reviewDetails      Json?
  /// Set only after an admin approval reprocesses the event successfully.
  /// Failed approval attempts remain visible in ActivityLog and lastError without stamping this field.
  reviewedAt         DateTime?
  /// User id of the approving admin. No FK so audit history survives user deletion.
  reviewedBy         String?
  receivedAt         DateTime @default(now())

  @@unique([connector, externalEventId])
  @@index([externalAsnId])
  @@index([processingStatus, nextRetryAt])
  @@index([deadLetteredAt])
  @@map("wms_inbound_receipt_events")
}

/// Generic inbound webhook event staging for push-primary WMS connectors (ShipHero).
/// Distinct from WmsInboundReceiptEvent (Mintsoft's ASN-specific poll model): ShipHero
/// pushes order/shipment/inventory webhooks, staged here by event type with idempotent
/// dedupe on (connector, externalEventId), retry/dead-letter state, and a monotonic
/// status rank guarding the writeback against out-of-order delivery.
model WmsWebhookEvent {
  id                 String    @id @default(cuid())
  connector          String
  eventType          String
  externalEventId    String
  /// Order ref (order_id / legacy_id) for status events; null for inventory events.
  externalOrderId    String?
  /// Rank of the event's fulfillment_status at receipt; the monotonic guard refuses
  /// to apply an event whose rank is below an already-applied one for the same order.
  statusRank         Int?
  payload            Json
  processedAt        DateTime?
  /// Set when the event applied but was a no-op because a higher-ranked status already won.
  supersededAt       DateTime?
  processingStatus   String    @default("PENDING")
  processingAttempts Int       @default(0)
  nextRetryAt        DateTime?
  deadLetteredAt     DateTime?
  lastError          String?
  receivedAt         DateTime  @default(now())

  @@unique([connector, externalEventId])
  @@index([processingStatus, nextRetryAt])
  @@index([connector, externalOrderId])
  @@index([deadLetteredAt])
  @@map("wms_webhook_events")
}

model WmsReturnsInbox {
  id               String                @id @default(cuid())
  connector        String
  externalReturnId String
  orderId          String?
