// onetwoInventory — Full Prisma Schema
// Prisma 7 · PostgreSQL · All modules

generator client {
  provider            = "prisma-client"
  output              = "../app/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  WAREHOUSE
  FINANCE
  READONLY
  SUPPLIER
}

enum ProductType {
  SIMPLE
  VARIABLE      // parent — not stockable itself
  VARIANT       // child of a VARIABLE parent
  KIT           // virtual bundle — stock calculated from components, deducted on sale
  BOM           // manufactured product — stock only exists after production run
  NON_INVENTORY // service / fee — unlimited, not tracked
}

enum ProductLifecycleStatus {
  DRAFT
  ACTIVE
  EOL
  ARCHIVED
}

enum WarehouseType {
  STANDARD
  QUARANTINE
  RESTOCK
}

enum StockMovementType {
  PURCHASE_RECEIPT
  WMS_RECEIPT_RECONCILIATION
  SALE_DISPATCH
  RETURN_INBOUND
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  PURCHASE_REVERSAL
  PRODUCTION_IN
  PRODUCTION_OUT
  KIT_ASSEMBLY_IN
  KIT_ASSEMBLY_OUT
  OPENING_STOCK
}

enum PurchaseOrderStatus {
  DRAFT
  RFQ_SENT
  QUOTE_RECEIVED
  PO_SENT
  SHIPPED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  INVOICED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PurchaseOrderType {
  GOODS      // primary PO for products
  FREIGHT    // secondary PO linked to goods PO (e.g. FedEx, customs)
}

enum LandedCostMethod {
  BY_VALUE
  BY_WEIGHT
  BY_QUANTITY
  EQUAL_SPLIT
}

enum SalesOrderStatus {
  DRAFT
  PENDING_PAYMENT
  ON_HOLD
  PROCESSING
  ALLOCATED
  PICKING
  PACKING
  SHIPPED
  COMPLETED
  DELIVERED
  CANCELLED
  // REFUNDED / PARTIALLY_REFUNDED retired — refund state is now the orthogonal
  // RefundDisposition (SalesOrder.refundStatus); an order can be e.g. DELIVERED + FULL.
}

// Refund disposition for a sales order, orthogonal to the fulfilment lifecycle status.
enum RefundDisposition {
  NONE
  PARTIAL
  FULL
}

enum ShipmentStatus {
  PENDING
  PICKING
  PACKED
  SHIPPED
}

enum StockTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductionOrderType {
  ASSEMBLY
  DISASSEMBLY
}

enum ProductionOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/**
 * o3d-wf86 — how a local document came to hold an external accounting document id.
 *
 * Ordered by how much the link can be TRUSTED, which is the only thing a later reader wants:
 *
 *   BILL_KEYED_SYNC  the sync row named this exact bill, so the link is what the connector itself
 *                    reported. Authoritative; allowed to overwrite a guess.
 *   PO_KEYED_REPAIR  a legacy PurchaseOrder-keyed row was attributed to this bill by the repair
 *                    sweep. Carefully guarded, but still a deduction from the local population
 *                    rather than something the ledger said.
 *   MANUAL           an operator released a stale claim and re-linked it by hand, having confirmed
 *                    the holder was stale (scripts/release-accounting-external-id-claim.ts).
 */
enum AccountingLinkSource {
  BILL_KEYED_SYNC
  PO_KEYED_REPAIR
  MANUAL
}

enum AccountingSyncType {
  PURCHASE_INVOICE
  PURCHASE_INVOICE_UPDATE
  COGS_JOURNAL
  INVENTORY_ADJUSTMENT
  SALES_INVOICE
  SALES_INVOICE_UPDATE
  INVOICE_PAYMENT
  BILL_ATTACHMENT
  INVOICE_PDF
  INVOICE_EMAIL
  WC_INVOICE_NOTE
  CREDIT_NOTE
  // audit-g5u2: supplier (purchase) credit note — Xero ACCPAYCREDIT.
  PURCHASE_CREDIT_NOTE
  // audit-v08m: follow-up that allocates the ACCPAYCREDIT to the bill it offsets.
  PURCHASE_CREDIT_NOTE_ALLOCATION
  STOCK_IN_TRANSIT
  STOCK_RECEIPT
  COGS_REVERSAL
  STOCK_ALLOCATION
  DAILY_BATCH_REVENUE_DEFERRAL
  DAILY_BATCH_INVENTORY_ALLOC
  DAILY_BATCH_GROUP_B
  // cogs-audit scjz.60.4: end-of-daily-batch sweep of the inventory subledger-vs-GL
  // rounding residue to the configured rounding-difference account (guarded; only
  // when the gap is within the sweep tolerance — material gaps are flagged, never swept).
  DAILY_BATCH_INVENTORY_RECONCILIATION
  // khdw: end-of-daily-batch sweep of the COGS subledger-vs-GL rounding residue
  // (same guard as inventory — sub-penny sweep, material gaps flagged never swept).
  DAILY_BATCH_COGS_RECONCILIATION
  // 6oyu.4 (khdw): end-of-daily-batch sweep of the STOCK_IN_TRANSIT subledger-vs-GL
  // rounding residue (same guard — sub-penny swept, material gaps flagged never swept).
  DAILY_BATCH_TRANSIT_RECONCILIATION
  UNEARNED_REV_REVERSAL
  // o3d-0i5y r9: reverses the part of a Group A2 Allocated-Inventory debit that an allocation
  // rewrite has ORPHANED — units A2 posted for that no longer sit on any allocation row, so no
  // dispatch will ever credit them and no refund will ever reach them. DR Inventory /
  // CR Allocated Inventory, raised inside the same transaction as the rewrite that orphaned them.
  ALLOCATION_REVERSAL
  BILL_PAYMENT
  REALISED_FX_JOURNAL
  UNREALISED_FX_JOURNAL
  MANUFACTURING_JOURNAL
  MANUFACTURING_RECLASS
  TAX_RATE_SYNC

  @@map("AccountingSyncType")
}

enum AccountingSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  // audit-46ry: deliberately abandoned rows (e.g. cross-connector orphans cancelled
  // when the active connector is switched). Distinct from FAILED so reconciliation /
  // event-backfill sweeps and FAILED-error dashboards don't treat them as unresolved
  // failures or re-queue the underlying document.
  CANCELLED

  @@map("AccountingSyncStatus")
}

// audit-g5u2: supplier credit-note lifecycle. DRAFT = recorded in IMS awaiting
// review; POSTED = pushed to the accounting connector (ACCPAYCREDIT) and eligible
// to offset a freight bill for cancellation.
enum SupplierCreditNoteStatus {
  DRAFT
  POSTED

  @@map("SupplierCreditNoteStatus")
}

enum ShoppingSyncDirection {
  TO_CONNECTOR
  FROM_CONNECTOR
}

enum ShoppingSyncStatus {
  PENDING
  SYNCED
  FAILED
  // o3d-iup: a connector refund the sync DELIBERATELY parked because it cannot be posted safely
  // (a monetary-only refund on a non-uniformly-taxed order). Distinct from FAILED so the refund
  // sweep's dedup skips it instead of re-importing and re-refusing it every run, and so FAILED-error
  // dashboards don't treat it as a transient failure. An operator resolves it (o3d-w00 #2/#5).
  QUARANTINED
}

enum StockSyncReason {
  IMS_CHANGE
  WC_WEBHOOK
  DAILY_RECONCILIATION
  MANUAL
}

enum StockSyncJobStatus {
  PENDING
  FAILED
}

enum ActivityEntityType {
  USER
  PRODUCT
  WAREHOUSE
  SUPPLIER
  CUSTOMER
  PURCHASE_ORDER
  SALES_ORDER
  STOCK_TRANSFER
  STOCK_COUNT
  STOCK_ADJUSTMENT
  PRODUCTION_ORDER
  SETTING
  IMPORT
  SYNC
  CURRENCY
  SYSTEM
  AccountingReconciliationFinding
}

enum ActivityLogLevel {
  INFO
  WARNING
  ERROR
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum TaxType {
  VAT
  GST
  NONE
}

enum TaxCategory {
  STANDARD
  REDUCED
  SECOND_REDUCED
  ZERO
  EXEMPT
}

enum CurrencyType {
  SALES
  PURCHASE
  BOTH
}

// ---------------------------------------------------------------------------
// AUTH & USERS
// ---------------------------------------------------------------------------

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           UserRole  @default(ADMIN)
  supplierId     String?   // set when role=SUPPLIER — links to their company
  pictureUrl     String?
  totpSecret     String?   // null = 2FA not enabled
  pendingTotpSecret String? // staged secret during setup before confirmation
  totpEnabled    Boolean   @default(false)
  active         Boolean   @default(true)
  sessionVersion Int       @default(1)
  forceLogoutAt  DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  activityLogs   ActivityLog[]
  notifications  Notification[]
  notificationReadReceipts NotificationReadReceipt[]
  sessions       Session[]
  passkeys       Passkey[]

  @@map("users")
}

model Passkey {
  id                  String   @id @default(cuid())
  userId              String
  credentialId        String   @unique
  credentialPublicKey Bytes
  counter             BigInt   @default(0)
  transports          String[] // e.g. ["usb", "ble", "nfc", "internal"]
  name                String   @default("Passkey")
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// ORGANISATION & SETTINGS
// ---------------------------------------------------------------------------

model Organisation {
  id             String  @id @default(cuid())
  name           String
  legalName      String?
  vatNumber      String?
  companyNumber  String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  county         String?
  postcode       String?
  country        String  @default("GB")
  phone          String?
  email          String?
  website        String?
  logoUrl        String?   // square icon logo (sidebar, top-left)
  documentLogoUrl String?  // wide/rectangular logo for PDF document headers
  baseCurrency   String  @default("GBP")
  // IANA timezone for displaying dates/times consistently across SSR + client
  // (e.g. "Europe/London"). Null falls back to Europe/London.
  timezone       String?
  financialYearStartMonth Int @default(5) // May = 5
  financialYearStartDay   Int @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("organisations")
}

/// Generic key/value settings store for integration configs etc.
model Setting {
  key       String   @id
  value     String   // JSON-encoded string
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Customisable document templates for PDF generation
model DocumentTemplate {
  id             String   @id @default(cuid())
  type           String   @unique // sales_order, purchase_order, invoice, packing_slip, credit_note, rfq
  headerNote     String?  // text above the table
  footerNote     String?  // text below the table
  termsText      String?  // terms & conditions
  customFooter   String?  // free text printed at the bottom of every page
  showLogo       Boolean  @default(true)
  showVat        Boolean  @default(true)
  showPaymentTerms Boolean @default(false)
  paymentTermsText String? // e.g. "Net 30 days"
  updatedAt      DateTime @updatedAt

  @@map("document_templates")
}

/// Configurable reasons for stock adjustments, each optionally linked to an accounting account.
/// accountCode is connector-agnostic: it is the account code in whichever accounting system
/// (Xero, QuickBooks, etc.) is currently active.
model AdjustmentReason {
  id              String   @id @default(cuid())
  name            String
  accountCode     String?  @map("account_code")
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alignDownBindings ExternalWmsBinding[] @relation("ExternalWmsBindingAlignDownReason")

  @@map("adjustment_reasons")
}

// ---------------------------------------------------------------------------
// CURRENCIES & FX
// ---------------------------------------------------------------------------

model Currency {
  code           String             @id // ISO 4217, e.g. "GBP"
  name           String
  symbol         String
  symbolPosition CurrencySymbolPos  @default(PREFIX) // "£23.99" vs "23.99 €"
  usedFor        CurrencyType       @default(BOTH)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now())

  fxRates        FxRate[]

  @@map("currencies")
}

enum CurrencySymbolPos {
  PREFIX
  POSTFIX
}

model FxRate {
  id             String   @id @default(cuid())
  fromCurrency   String   // always GBP (base)
  toCurrency     String
  rate           Decimal  @db.Decimal(18, 8) // 1 GBP = rate toCurrency
  fetchedAt      DateTime @default(now())
  /// Provenance of the rate. 'frankfurter' for ECB cron fetches, 'manual'
  /// when an admin pins a rate via the Currencies settings page. Lets the
  /// fetch loop skip override currencies and the UI badge them.
  source         String   @default("frankfurter")
  /// True when the row was inserted as a manual override. Stays true on the
  /// row forever; "clearing" the override means inserting a newer, non-
  /// override row that becomes the latest.
  manualOverride Boolean  @default(false)

  currency       Currency @relation(fields: [toCurrency], references: [code])

  @@index([toCurrency, fetchedAt])
  @@map("fx_rates")
}

/// Audit trail for outbound FX rate pushes from IMS to shopping connectors
/// (currently WooCommerce via the onetwoInventory Helper plugin). One row
/// per push attempt, success or failure. Surfaced on the Currencies
/// settings page so admins can see when a push last succeeded and whether
/// any errors occurred.
model FxRatePushLog {
  id           String   @id @default(cuid())
  connector    String   // 'woocommerce' | future: 'shopify' | etc.
  pushedAt     DateTime @default(now())
  ratesCount   Int
  status       String   // 'OK' | 'FAILED' | 'SKIPPED'
  errorMessage String?

  @@index([connector, pushedAt(sort: Desc)])
  @@map("fx_rate_push_log")
}

// ---------------------------------------------------------------------------
// TAX
// ---------------------------------------------------------------------------

model TaxRate {
  id          String      @id @default(cuid())
  name        String      // e.g. "UK Standard Rate"
  rate        Decimal     @db.Decimal(5, 4) // e.g. 0.2000 for 20%
  type        TaxType     @default(VAT)
  taxCategory TaxCategory @default(STANDARD)
  usedFor     String      @default("BOTH") // SALES, PURCHASE, BOTH
  accountingTaxType String?  @map("accounting_tax_type") // Accounting tax type code e.g. "OUTPUT2", "INPUT2"
  countryCode String?     // ISO 3166-1 alpha-2, null = applies globally
  isCompound  Boolean     @default(false) @map("is_compound")
  reverseCharge Boolean   @default(false) @map("reverse_charge")
  reportingCategory String? @map("reporting_category") // e.g. DOMESTIC, REVERSE_CHARGE, EC_SALES, OSS
  active      Boolean     @default(true)
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  components         TaxRateComponent[]
  supplierTaxRate    Supplier[]
  orderLines         SalesOrderLine[]
  poLines            PurchaseOrderLine[]
  shoppingTaxRateMappings ShoppingTaxRateMapping[]

  @@index([countryCode, taxCategory, usedFor])
  @@map("tax_rates")
}

model TaxRateComponent {
  id                 String   @id @default(cuid())
  taxRateId          String   @map("tax_rate_id")
  name               String
  rate               Decimal  @db.Decimal(5, 4)
  compoundOnPrevious Boolean  @default(false) @map("compound_on_previous")
  accountingTaxType  String?  @map("accounting_tax_type")
  sortOrder          Int      @default(0) @map("sort_order")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Cascade)

  @@index([taxRateId, sortOrder])
  @@map("tax_rate_components")
}

// ---------------------------------------------------------------------------
// WAREHOUSES
// ---------------------------------------------------------------------------

model Warehouse {
  id                    String        @id @default(cuid())
  code                  String        @unique // e.g. MIL1, CBG, RES, QUA (o3d-0o3y: EAR2/Earith retired when Fulfillable moved us to MIL1/Mildenhall)
  name                  String
  type                  WarehouseType @default(STANDARD)
  availableForSale      Boolean       @default(true)
  syncToStore           Boolean       @default(false)
  contactName           String?
  email                 String?
  phone                 String?
  addressLine1          String?
  addressLine2          String?
  city                  String?
  postcode              String?
  country               String        @default("GB")
  isDefault             Boolean       @default(false)
  defaultReturnWarehouse Boolean      @default(false)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  stockLevels           StockLevel[]
  costLayers            CostLayer[]
  inventorySnapshots    InventorySnapshot[]
  inventoryReservationSnapshots InventoryReservationSnapshot[]
  transfersFrom         StockTransfer[] @relation("TransferFrom")
  transfersTo           StockTransfer[] @relation("TransferTo")
  stockCounts           StockCount[]
  movementsFrom         StockMovement[] @relation("MovementFromWarehouse")
  movementsTo           StockMovement[] @relation("MovementToWarehouse")
  productionOrders      ProductionOrder[]
  orderShipments        SalesOrder[]    @relation("ShipFromWarehouse")
  refundReturns         SalesOrderRefund[]
  incomingPurchaseOrders PurchaseOrder[] @relation("PODestinationWarehouse")
  orderAllocations      OrderAllocation[]
  shipments             Shipment[]
  wmsBindings           ExternalWmsBinding[]
  wmsAsnMaps            WmsAsnMap[]            @relation("WmsAsnMapWarehouse")
  wmsSyncJobs           WmsSyncJob[]           @relation("WmsSyncJobWarehouse")
  wmsStockSnapshots     WmsStockSnapshot[]     @relation("WmsStockSnapshotWarehouse")
  wmsStockDiscrepancies WmsStockDiscrepancy[]  @relation("WmsStockDiscrepancyWarehouse")
  wmsReturnsInbox       WmsReturnsInbox[]      @relation("WmsReturnsInboxWarehouse")

  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "warehouses_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "warehouses_name_trgm_idx")
  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// PRODUCTS
// ---------------------------------------------------------------------------

model Product {
  id              String      @id @default(cuid())
  sku             String      @unique
  name            String
  description     String?
  type            ProductType @default(SIMPLE)
  /// o3d-4kfh r6 (Codex finding 1): the FULFILMENT GRAPH VERSION of this product — bumped whenever
  /// anything that changes what a sales line for it is deemed to require changes: its own component
  /// list, its own KIT-ness, or the same on any KIT descendant (the bump walks the KIT-ancestor set,
  /// `collectFulfillmentAffectedRootProducts`).
  ///
  /// `OrderAllocation.fulfillmentGraphVersion` stamps the value the allocation was computed against,
  /// and commitment/dispatch refuses when the two disagree. That is a compare-and-swap on one
  /// integer, and it is the ONLY thing that catches a UNIFORM rescale of a kit (2xA+1xB -> 4xA+2xB):
  /// proportionality against a mutable current graph cannot distinguish that race from a legitimate
  /// partial shipment, because the committed set is exactly proportional to the new recipe.
  ///
  /// Starts at 0 for every product and every allocation row, so nothing pre-existing reads as stale.
  fulfillmentGraphVersion Int @default(0) @map("fulfillment_graph_version")
  lifecycleStatus ProductLifecycleStatus @default(ACTIVE)
  categoryId      String?
  parentId        String?     // set for VARIANT products
  barcode         String?     @unique
  mpn             String?
  hsCode          String?
  countryOfOrigin String?     // 2-letter ISO code
  customsDescription String?  // free-text goods description for customs paperwork
  weight          Decimal?    @db.Decimal(10, 4) // kg, for landed cost by weight
  active          Boolean     @default(true)

  // Dimensions (cm)
  widthCm         Decimal?    @db.Decimal(10, 2)
  heightCm        Decimal?    @db.Decimal(10, 2)
  depthCm         Decimal?    @db.Decimal(10, 2)

  // Media
  imageUrl        String?     // primary image URL (can be imported from WooCommerce)

  // WooCommerce mapping — resolved once via SKU lookup then persisted for O(1) sync.
  // BigInt because WooCommerce/WordPress object IDs are unbounded by the
  // signed-32-bit range; a long-lived store can easily cross 2^31.
  externalProductId BigInt?   @unique

  // Accounting item mapping — same idea as externalProductId above, and as
  // Customer/Supplier.accountingContactId: resolved once, then persisted so the
  // per-invoice "does this item exist?" lookup costs nothing (o3d-3nc).
  // Connector-agnostic by design: it holds an id belonging to whichever accounting
  // connector is currently connected, so BOTH connectors clear it on disconnect —
  // a Xero ItemID handed to QuickBooks is meaningless.
  accountingItemId String?
  // "<connector>:<tenantId>" of the connection that issued accountingItemId (o3d-6nd). A reader ignores
  // an id whose provenance does not match the active connection and re-resolves it, so a connector/org
  // switch that bypasses disconnect cannot serve one connection's id to another. NULL => re-resolve once.
  accountingItemProvenance String?

  // Pricing (GBP)
  salesPriceBase   Decimal?    @db.Decimal(12, 4)   // regular / list price
  salePriceBase    Decimal?    @db.Decimal(12, 4)   // sale / discounted price
  salesPriceTaxInclusive Boolean @default(false)

  // Tax
  taxCategory     TaxCategory @default(STANDARD)

  // Stock behaviour
  stockUnit       String      @default("pcs")       // display unit for stock levels, e.g. "pcs", "m", "kg"
  oversellAllowed Boolean     @default(true)        // continue selling when out of stock
  reorderPoint    Decimal?    @db.Decimal(12, 4)
  reorderQty      Decimal?    @db.Decimal(12, 4)
  safetyStockQty  Decimal?    @db.Decimal(12, 4)
  leadTimeDays         Int?    // manual lead-time override (days); null = use observed/default
  observedLeadTimeDays Int?    // auto P95 lead time from PO receipts (cron-maintained)
  abcClass        String?
  preferredSupplierId String?
  preferredSupplierLocked Boolean @default(false)
  preferredSupplierUpdatedAt DateTime?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parent          Product?    @relation("ProductVariants", fields: [parentId], references: [id])
  variants        Product[]   @relation("ProductVariants")

  stockLevels     StockLevel[]
  costLayers      CostLayer[]
  inventorySnapshots InventorySnapshot[]
  inventoryReservationSnapshots InventoryReservationSnapshot[]
  costLayerSourceLines CostLayerSourceLine[]
  stockMovements  StockMovement[]

  poLines         PurchaseOrderLine[]
  supplierProducts SupplierProduct[]
  preferredSupplier Supplier? @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id], onDelete: SetNull)

  salesOrderLines SalesOrderLine[]
  returnLines     SalesOrderRefundLine[]

  options         ProductOption[]

  // BOM (this product is the finished good)
  bomAsParent     BomItem[]   @relation("BomParent")
  // BOM (this product is a component)
  bomAsComponent  BomItem[]   @relation("BomComponent")

  // Kit items (this product is the kit)
  kitItems        KitItem[]   @relation("KitParent")
  // Kit items (this product is a component)
  kitItemsAsComponent KitItem[] @relation("KitItemComponent")

  // Product components: direct component list for KIT / BOM products
  productComponents     ProductComponent[] @relation("ProductHasComponents")
  usedAsComponentIn     ProductComponent[] @relation("ProductUsedAsComponent")

  productionOrdersAsOutput ProductionOrder[]

  orderAllocations OrderAllocation[]
  shipmentLines    ShipmentLine[]
  stockSyncStates  StockSyncState[]
  stockSyncJobs    StockSyncJob[]
  shoppingLinks    ShoppingProductLink[]
  wmsProductLinks  WmsProductLink[]
  wmsBundleLinks   WmsBundleLink[]
  wmsAsnLineMaps   WmsAsnLineMap[]       @relation("WmsAsnLineMapProduct")
  wmsSyncLogs      WmsSyncLog[]          @relation("WmsSyncLogProduct")
  wmsStockSnapshots WmsStockSnapshot[]   @relation("WmsStockSnapshotProduct")
  wmsStockDiscrepancies WmsStockDiscrepancy[] @relation("WmsStockDiscrepancyProduct")
  hsCodeProposals  HsCodeProposal[]
  wmsReturnsInbox  WmsReturnsInbox[]     @relation("WmsReturnsInboxProduct")

  @@index([parentId])
  @@index([categoryId])
  @@index([preferredSupplierId])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@unique([accountingItemId, accountingItemProvenance])
  @@map("products")
}

/// Product reporting category assigned to products for inventory and CSV reporting.
/// Categories are auto-created from product forms/imports and preserve the first
/// display spelling while matching future writes by normalized name.
model ProductCategory {
  id             String            @id @default(cuid())
  /// Operator-facing display name.
  name           String            @db.VarChar(100)
  /// Diacritic-insensitive normalized lookup key for case-insensitive matching.
  nameNormalized String            @unique @map("name_normalized") @db.VarChar(100)
  parentId       String?
  parent         ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       ProductCategory[] @relation("ProductCategoryTree")
  products       Product[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([parentId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_categories_name_trgm_idx")
  @@map("product_categories")
}

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g. "Color", "Size"
  values    String   // comma-separated: "Red,Blue,Green"
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name], map: "product_options_productId_name_key")
  @@index([productId])
  @@map("product_options")
}

/// Component list for KIT (virtual bundle) and BOM (manufactured) products
model ProductComponent {
  id            String   @id @default(cuid())
  productId     String   // the KIT or BOM product
  componentId   String   // component product
  qty           Decimal  @db.Decimal(12, 4)
  sortOrder     Int      @default(0)

  product       Product  @relation("ProductHasComponents", fields: [productId], references: [id], onDelete: Cascade)
  component     Product  @relation("ProductUsedAsComponent", fields: [componentId], references: [id])

  @@unique([productId, componentId])
  @@map("product_components")
}

// ---------------------------------------------------------------------------
// STOCK
// ---------------------------------------------------------------------------

model StockLevel {
  id              String    @id @default(cuid())
  productId       String
  warehouseId     String
  quantity        Decimal   @db.Decimal(14, 6) @default(0) // enforced non-negative in DB; 6dp matches cost_layers/FIFO engine
  reservedQty     Decimal   @db.Decimal(14, 6) @default(0) // enforced non-negative in DB; in transit / allocated; 6dp matches cost_layers
  updatedAt       DateTime  @updatedAt

  product         Product   @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@map("stock_levels")
}

/// FIFO cost layers — one row per goods receipt (or opening stock seed)
model CostLayer {
  id              String    @id @default(cuid())
  productId       String
  warehouseId     String
  receivedQty     Decimal   @db.Decimal(14, 6) // enforced non-negative in DB; 6dp matches the FIFO engine + cogs_entries
  remainingQty    Decimal   @db.Decimal(14, 6) // enforced non-negative in DB and <= receivedQty; 6dp matches the FIFO engine
  unitCostBase     Decimal   @db.Decimal(18, 6) // landed cost per unit in GBP
  receivedAt      DateTime  @default(now())
  poLineId        String?   // link back to the PO line that created this layer
  adjustmentMovementId String? @map("adjustment_movement_id")
  productionOrderId String?  @map("production_order_id")
  isOpeningStock  Boolean   @default(false)

  product         Product   @relation(fields: [productId], references: [id])
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  poLine          PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  adjustmentMovement StockMovement? @relation("AdjustmentMovementLayer", fields: [adjustmentMovementId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  cogsEntries     CogsEntry[]
  sourceLines     CostLayerSourceLine[]
  revaluations    CostLayerRevaluation[]

  @@index([productId, warehouseId, receivedAt])
  @@index([adjustmentMovementId])
  @@index([productionOrderId])
  @@map("cost_layers")
}

// Event log of every change to a cost layer's unitCostBase (landed-cost recalc,
// manufacturing recompute, FX rebase, adjustment edit), so as-of/historical
// valuation can reconstruct the cost basis valid at a point in time instead of
// using the current (post-revaluation) cost (cogs-audit scjz.43/.48).
model CostLayerRevaluation {
  id              String    @id @default(cuid())
  costLayerId     String
  oldUnitCostBase Decimal   @db.Decimal(18, 6)
  newUnitCostBase Decimal   @db.Decimal(18, 6)
  effectiveAt     DateTime
  reason          String?
  createdAt       DateTime  @default(now())

  costLayer       CostLayer @relation(fields: [costLayerId], references: [id], onDelete: Cascade)

  @@index([costLayerId, effectiveAt])
  @@map("cost_layer_revaluations")
}

model CostLayerSourceLine {
  id                String    @id @default(cuid())
  costLayerId       String
  sourceProductId   String
  sourceCostLayerId String?
  qty               Decimal   @db.Decimal(12, 4)
  unitCostBase      Decimal   @db.Decimal(18, 6)
  totalCostBase     Decimal   @db.Decimal(18, 6)
  createdAt         DateTime  @default(now())

  costLayer         CostLayer @relation(fields: [costLayerId], references: [id], onDelete: Cascade)
  sourceProduct     Product   @relation(fields: [sourceProductId], references: [id])

  @@index([costLayerId])
  @@index([sourceProductId])
  @@index([sourceCostLayerId])
  @@map("cost_layer_source_lines")
}

/// Each COGS consumption event (sale, adjustment, etc.)
model CogsEntry {
  id            String            @id @default(cuid())
  costLayerId   String
  movementId    String
  qty           Decimal           @db.Decimal(14, 6)
  unitCostBase   Decimal           @db.Decimal(18, 6)
  totalCostBase  Decimal           @db.Decimal(18, 6)
  createdAt     DateTime          @default(now())

  costLayer     CostLayer         @relation(fields: [costLayerId], references: [id])
  movement      StockMovement     @relation(fields: [movementId], references: [id])

  @@map("cogs_entries")
}

/// khdw: independent subledger of GL COGS-account movements, used by the daily-batch
/// COGS subledger-vs-GL rounding reconciliation. One signed row per COGS-account
/// posting that does NOT have a native structured home: refund COGS reversals,
/// shipment COGS revaluations, and landed-cost COGS adjustments. (Dispatch COGS is
/// reconciled from its native field Shipment.cogsBatchAmount, so it is not recorded
/// here.) `baseDelta` is the signed base-currency COGS movement — positive = COGS
/// debited (increased), negative = credited (decreased) — at the highest precision
/// the source carries (6dp refund cost-layer total; 2dp-exact reval/landed-cost).
/// `journalDate` is the GL date the movement posts on, so the reconciliation windows
/// it the same way it windows Shipment.shipmentJournalDate on the dispatch side.
model CogsSubledgerMovement {
  id             String   @id @default(cuid())
  // 'REFUND_REVERSAL' | 'SHIPMENT_REVALUATION' | 'LANDED_COST_ADJUSTMENT'
  sourceType     String   @map("source_type")
  // originating entity (refundId / shipmentId / purchaseOrderId) for traceability
  sourceRef      String   @map("source_ref")
  // dedupes re-staged/retried postings; mirrors the COGS journal's idempotency key
  idempotencyKey String   @unique @map("idempotency_key")
  baseDelta      Decimal  @db.Decimal(18, 6) @map("base_delta")
  journalDate    DateTime @map("journal_date")
  createdAt      DateTime @default(now())

  @@index([journalDate])
  @@map("cogs_subledger_movements")
}

/// 6oyu.4 (epic khdw): append-only subledger of every GL STOCK_IN_TRANSIT-account
/// movement, used by the daily-batch transit GL reconciliation. Mirrors
/// CogsSubledgerMovement exactly. Transit is a clearing account: bills DEBIT it
/// (+ baseDelta), and receipt / reclass / credit notes / cancellations CREDIT it
/// (− baseDelta). `journalDate` is the GL date the movement posts on, so the
/// reconciliation windows it the same way it windows the transit balance snapshots.
model TransitSubledgerMovement {
  id             String   @id @default(cuid())
  // 'PURCHASE_BILL' | 'PURCHASE_BILL_UPDATE' | 'SUPPLIER_CREDIT_NOTE' | 'STOCK_RECEIPT'
  // | 'LANDED_COST_RECLASS' | 'LANDED_COST_CONSUMED_OFFSET' | 'PURCHASE_ORDER_CANCEL'
  // | 'SUPPLIER_RETURN'
  sourceType     String   @map("source_type")
  // originating entity (purchaseOrderId / creditNoteId) for traceability
  sourceRef      String   @map("source_ref")
  // dedupes re-staged/retried postings; mirrors the transit journal's idempotency key
  idempotencyKey String   @unique @map("idempotency_key")
  baseDelta      Decimal  @db.Decimal(18, 6) @map("base_delta")
  journalDate    DateTime @map("journal_date")
  createdAt      DateTime @default(now())

  @@index([journalDate])
  @@map("transit_subledger_movements")
}

/// Governed by additional db-native reporting guarantees from migration
/// 20260602103000_stock_movement_reporting_guarantees:
/// - value fields must both be null or both populated, and totalValueBase must
///   equal ROUND(qty * unitCostBase, 6)
/// - deferred evidence trigger requires inbound receipt/production/adjustment
///   movements to have cost-layer evidence and outbound dispatch/production/
///   adjustment movements to have COGS evidence by commit time
model StockMovement {
  id              String            @id @default(cuid())
  type            StockMovementType
  productId       String
  fromWarehouseId String?
  toWarehouseId   String?
  qty             Decimal           @db.Decimal(14, 6) // always positive; enforced non-negative in DB; 6dp matches cost_layers/FIFO engine
  note            String?
  referenceType   String?           // e.g. "PurchaseOrder", "SalesOrder"
  referenceId     String?           // ID of the related entity
  /// Deterministic key for irreversible stock-movement flows. Null for legacy/manual rows.
  /// Keys are built by lib/domain/inventory/stock-movement-idempotency.ts.
  idempotencyKey  String?           @unique
  /// Reporting denormalization: unit cost in base currency at movement time.
  /// Null means historical source cost provenance was unavailable during backfill.
  /// Derivation: FIFO consumption for outbound, cost-layer or transfer snapshot for inbound, zero for historical demand imports.
  unitCostBase    Decimal?          @db.Decimal(18, 6)
  /// Reporting denormalization: total movement value in base currency.
  /// Expected to match qty * unitCostBase within inventory invariant tolerance.
  totalValueBase  Decimal?          @db.Decimal(18, 6)
  /// Durable line-granularity link from a sale-dispatch movement to the
  /// originating ShipmentLine (and thus the SalesOrderLine). Populated for
  /// SALE_DISPATCH movements created from a real shipment; null for other
  /// movement types and for zero-cost historical-import demand rows.
  /// Promotes the latent `SALE_DISPATCH:shipmentLine:<id>` idempotency-key
  /// linkage into a first-class column so revenue↔COGS reporting can join at
  /// shipment-line granularity (cogs-audit scjz.51/.67, epic 4pz6).
  shipmentLineId  String?
  createdAt       DateTime          @default(now())

  product         Product           @relation(fields: [productId], references: [id])
  fromWarehouse   Warehouse?        @relation("MovementFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?        @relation("MovementToWarehouse", fields: [toWarehouseId], references: [id])
  shipmentLine    ShipmentLine?     @relation(fields: [shipmentLineId], references: [id], onDelete: SetNull)

  adjustmentLayers CostLayer[]      @relation("AdjustmentMovementLayer")
  cogsEntries     CogsEntry[]

  @@index([productId])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@index([shipmentLineId])
  @@index([referenceType, referenceId])
  @@index([referenceType(ops: raw("gin_trgm_ops"))], type: Gin, map: "stock_movements_reference_type_trgm_idx")
  @@index([referenceId(ops: raw("gin_trgm_ops"))], type: Gin, map: "stock_movements_reference_id_trgm_idx")
  @@index([note(ops: raw("gin_trgm_ops"))], type: Gin, map: "stock_movements_note_trgm_idx")
  @@map("stock_movements")
}

/// Per-migration stock movement value backfill audit. The id format is
/// <migration_name>:<movementType>:<reason> so multiple data migrations can
/// coexist; runAt updates on retry while firstRunAt preserves first occurrence.
model StockMovementBackfillAudit {
  id           String            @id
  movementType StockMovementType
  count        Int
  reason       String
  firstRunAt   DateTime          @default(now())
  runAt        DateTime          @default(now())

  @@map("stock_movement_backfill_audit")
}

/// Daily product/warehouse inventory position for reporting. Quantities come
/// from StockLevel; values come from open FIFO CostLayer rows at snapshot time.
/// Rows are sparse: absence for a product/warehouse/date means zero position.
/// Re-running a date is idempotent via the unique key and updates the captured
/// row in place. Drift between StockLevel quantity and FIFO-layer remaining
/// quantity is logged by the cron but snapshots still persist. These rows are
/// point-in-time captures, not live relations back to StockMovement/CostLayer.
model InventorySnapshot {
  id           String   @id @default(cuid())
  snapshotDate DateTime @db.Date
  productId    String
  warehouseId  String
  qty          Decimal  @db.Decimal(14, 6) // 6dp matches live stock_levels/cost_layers
  valueBase    Decimal  @db.Decimal(18, 6)
  unitCostBase Decimal? @db.Decimal(18, 6)
  // False when this snapshot's value is not point-in-time accurate — e.g. a
  // backfilled row seeded from current cost layers that were revalued after this
  // date, so its valueBase reflects a later cost basis (cogs-audit scjz.43/.48).
  valueReplayReliable Boolean @default(true)
  createdAt    DateTime @default(now())

  product      Product   @relation(fields: [productId], references: [id])
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([snapshotDate, productId, warehouseId])
  @@index([snapshotDate])
  @@index([productId, snapshotDate])
  @@index([warehouseId, snapshotDate])
  @@map("inventory_snapshots")
}

/// Daily coverage marker for sparse InventorySnapshot rows. If a run exists for a
/// snapshotDate, absent product/warehouse rows represent a genuine zero on-hand
/// position for that day, so an empty inventory_snapshots result for the date is a
/// real zero subledger value (used by the inventory GL reconciliation, scjz.60.5)
/// rather than an uncovered date. If no run exists, callers must treat empty rows
/// as missing evidence, not zero. Mirrors InventoryReservationSnapshotRun.
model InventorySnapshotRun {
  id              String    @id @default(cuid())
  snapshotDate    DateTime  @unique @db.Date
  stockLevelCount Int
  snapshotCount   Int
  source          String    @default("cron")
  checkMethod     String    @default("daily_current_state_v1")
  cutoffAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("inventory_snapshot_runs")
}

/// Daily product/warehouse reservation position for true as-of availability
/// reporting. Rows are captured from StockLevel.reservedQty and current
/// quantity at snapshot time, with reservationSourceCount recording the count
/// of distinct source rows behind the balance, not the reserved quantity sum.
/// A missing row means zero reserved only when InventoryReservationSnapshotRun
/// exists for that date. Re-running a date is idempotent via the unique key and
/// updates the captured row in place.
model InventoryReservationSnapshot {
  id                     String   @id @default(cuid())
  snapshotDate           DateTime @db.Date
  productId              String
  warehouseId            String
  reservedQty            Decimal  @db.Decimal(14, 6) // 6dp matches live stock_levels/cost_layers
  availableQty           Decimal  @db.Decimal(14, 6) // 6dp matches live stock_levels/cost_layers
  reservationSourceCount Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product                Product   @relation(fields: [productId], references: [id])
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([snapshotDate, productId, warehouseId], map: "inventory_reservation_snapshots_snapshotDate_productId_warehous")
  @@index([productId, snapshotDate])
  @@index([warehouseId, snapshotDate])
  @@map("inventory_reservation_snapshots")
}

/// Daily coverage marker for sparse InventoryReservationSnapshot rows. If a
/// run exists for a snapshotDate, absent product/warehouse rows represent zero
/// reserved quantity for that day. If no run exists, historical reports must
/// surface reservation evidence as missing instead of silently assuming zero.
model InventoryReservationSnapshotRun {
  id                       String   @id @default(cuid())
  snapshotDate             DateTime @unique @db.Date
  stockLevelCount          Int
  reservationSnapshotCount Int
  source                   String   @default("cron")
  checkMethod              String   @default("daily_current_state_v1")
  cutoffAt                 DateTime?
  reservationSourceCount   Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("inventory_reservation_snapshot_runs")
}

// ---------------------------------------------------------------------------
// SUPPLIERS
// ---------------------------------------------------------------------------

model Supplier {
  id              String    @id @default(cuid())
  name            String
  accountingContactId String?
  // Provenance of accountingContactId — see Product.accountingItemProvenance (o3d-6nd).
  accountingContactProvenance String?
  contactName     String?
  email           String?
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  county          String?
  postcode        String?
  country         String?
  currency        String    @default("GBP")
  taxRateId       String?
  vatNumber       String?
  accountNumber   String?   // our account ref with supplier
  paymentTermsDays Int?
  /**
   * Prepaid / deposit supplier. When true, purchase invoices (bills) for this
   * supplier's POs may be raised before goods are received — the three-way
   * match control (bill ≤ received qty) is relaxed to the ordered quantity.
   * Pay-on-receipt suppliers (the default) keep the control enforced so a
   * bill can never exceed what has actually been received.
   */
  prepaid         Boolean   @default(false)
  /**
   * User-entered override for expected delivery time in days. Does NOT
   * overwrite the computed average — the average is always shown alongside
   * as read-only info in the supplier form.
   */
  manualDeliveryDays Int?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  taxRate         TaxRate?  @relation(fields: [taxRateId], references: [id])
  purchaseOrders  PurchaseOrder[]
  supplierProducts SupplierProduct[]
  preferredForProducts Product[] @relation("ProductPreferredSupplier")
  productionOrders ProductionOrder[]
  users           User[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_name_trgm_idx")
  @@unique([accountingContactId, accountingContactProvenance])
  @@map("suppliers")
}

/// Last known purchase price per supplier per product
model SupplierProduct {
  id              String    @id @default(cuid())
  supplierId      String
  productId       String
  supplierSku     String?   // supplier's own SKU/reference
  lastUnitCost    Decimal   @db.Decimal(18, 6)
  currency        String    // supplier's currency
  leadTimeDays    Int?
  updatedAt       DateTime  @updatedAt

  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])

  @@unique([supplierId, productId])
  @@map("supplier_products")
}

// ---------------------------------------------------------------------------
// PURCHASE ORDERS
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id              String              @id @default(cuid())
  reference       String              @unique // e.g. PO-2024-0001
  type            PurchaseOrderType   @default(GOODS)
  supplierId      String
  status          PurchaseOrderStatus @default(DRAFT)
  currency        String              // PO currency
  fxRateToBase     Decimal             @db.Decimal(18, 8) // rate at time of creation
  subtotalForeign Decimal             @db.Decimal(18, 4)
  subtotalBase     Decimal             @db.Decimal(18, 4)
  taxRateName     String?             // e.g. "UK Standard Rate"
  taxRatePercent  Decimal?            @db.Decimal(5, 4) // e.g. 0.2000
  pricesIncludeVat Boolean            @default(false) // true when unit prices (and the header discount) are tax-inclusive (o3d-lx1)
  taxForeign      Decimal             @db.Decimal(18, 4) @default(0)
  taxBase          Decimal             @db.Decimal(18, 4) @default(0)
  totalForeign    Decimal             @db.Decimal(18, 4)
  totalBase        Decimal             @db.Decimal(18, 4)

  // Supplier direct freight/fees (in addition to linked freight POs)
  directFreightForeign Decimal        @db.Decimal(18, 4) @default(0)
  directFreightBase     Decimal        @db.Decimal(18, 4) @default(0)

  // Order-level discount (applied on top of any per-line discounts)
  discountStr      String?            // user input e.g. "10%" or "50.00"
  discountAmount   Decimal            @db.Decimal(18, 4) @default(0) // computed order discount in foreign currency, same tax convention as lines

  landedCostMethod LandedCostMethod  @default(BY_VALUE)

  destinationWarehouseId String?    // where goods will be received (can change before receipt)

  trackingNumber  String?
  shippingProvider String?

  notes           String?
  internalNotes   String?
  supplierRef     String?            // supplier's own PO/invoice reference
  skipPreferredSupplierUpdate Boolean @default(false)
  expectedDelivery DateTime?
  receivedAt      DateTime?
  invoicedAt      DateTime?

  // Email tracking
  rfqSentAt       DateTime?
  poSentAt        DateTime?

  archived        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  supplier             Supplier   @relation(fields: [supplierId], references: [id])
  destinationWarehouse Warehouse? @relation("PODestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  lines           PurchaseOrderLine[]
  receipts        PurchaseReceipt[]
  invoices        PurchaseInvoice[]
  returns         PurchaseReturn[]
  supplierCreditNotes SupplierCreditNote[]

  // Landed cost links — this PO as primary
  landedCostLinks LandedCostLink[]   @relation("PrimaryPO")
  // This PO as freight/secondary
  asFreightFor    LandedCostLink[]   @relation("FreightPO")
  freightCostLines FreightCostLine[]

  @@index([supplierId])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String    @id @default(cuid())
  poId            String
  productId       String
  description     String?   // override product name if needed
  qty             Decimal   @db.Decimal(12, 4) // always in stock units
  purchaseUnitId  String?
  purchaseUnitQty Decimal?  @db.Decimal(12, 4) // qty in purchase units (e.g. 2 boxes)
  unitCostForeign Decimal   @db.Decimal(18, 6)  // effective net cost per stock unit (post-discount, post-VAT extraction)
  unitCostBase     Decimal   @db.Decimal(18, 6)  // effective net cost per stock unit in GBP
  discountStr     String?   // e.g. "5%" or "2.50" — original user input (display only)
  discountAmount  Decimal   @db.Decimal(18, 4) @default(0) // line discount amount in foreign currency (same inclusive/exclusive convention as the user-entered unit cost)
  taxRateId       String?
  taxForeign      Decimal   @db.Decimal(18, 4) @default(0)
  taxBase          Decimal   @db.Decimal(18, 4) @default(0)
  totalForeign    Decimal   @db.Decimal(18, 4) // net of discount and VAT
  totalBase        Decimal   @db.Decimal(18, 4) // net of discount and VAT
  landedUnitCostBase Decimal @db.Decimal(18, 6) @default(0) // set after landed cost allocation
  reorderEvidence Json?
  qtyReceived     Decimal   @db.Decimal(12, 4) @default(0)
  qtyReturned     Decimal   @db.Decimal(12, 4) @default(0)
  sortOrder       Int       @default(0)

  po              PurchaseOrder    @relation(fields: [poId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  purchaseUnit    PurchaseUnit?    @relation(fields: [purchaseUnitId], references: [id])
  taxRate         TaxRate?         @relation(fields: [taxRateId], references: [id])
  receiptLines    PurchaseReceiptLine[]
  returnLines     PurchaseReturnLine[]
  invoiceLines    PurchaseInvoiceLine[]
  costLayers      CostLayer[]

  @@index([poId])
  @@index([productId])
  @@map("purchase_order_lines")
}

/// Purchase units — conversion from purchase packaging to stock units
model PurchaseUnit {
  id               String   @id @default(cuid())
  name             String   // e.g. "Box of 100", "Roll (1km)", "Pallet of 48"
  abbreviation     String   // e.g. "box", "roll", "plt"
  conversionFactor Decimal  @db.Decimal(12, 4) // 1 purchase unit = X stock units
  stockUnitName    String   @default("pcs") // what each stock unit is called, e.g. "m", "pcs", "sheets"
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  poLines          PurchaseOrderLine[]

  @@map("purchase_units")
}

/// Links a freight/secondary PO to a primary goods PO for landed cost distribution
model LandedCostLink {
  id              String           @id @default(cuid())
  primaryPoId     String
  freightPoId     String
  method          LandedCostMethod @default(BY_VALUE)
  allocated       Boolean          @default(false) // true once cost has been distributed
  createdAt       DateTime         @default(now())

  primaryPO       PurchaseOrder    @relation("PrimaryPO", fields: [primaryPoId], references: [id])
  freightPO       PurchaseOrder    @relation("FreightPO", fields: [freightPoId], references: [id])

  @@unique([primaryPoId, freightPoId])
  @@map("landed_cost_links")
}

model LandedCostRevaluationRun {
  id             String   @id @default(cuid())
  freightPoId    String?
  primaryPoId    String?
  triggeredById  String?
  status         String
  reason         String?
  beforeJson     Json
  afterJson      Json
  accountingJson Json?
  warningsJson   Json?
  createdAt      DateTime @default(now())

  @@index([freightPoId, createdAt])
  @@index([primaryPoId, createdAt])
  @@index([status, createdAt])
  @@map("landed_cost_revaluation_runs")
}

/// Individual cost line items on a FREIGHT-type PO
model FreightCostLine {
  id                 String           @id @default(cuid())
  poId               String
  description        String
  amountForeign      Decimal          @db.Decimal(18, 4)
  amountBase          Decimal          @db.Decimal(18, 4)
  vatable            Boolean          @default(false)
  distributionMethod LandedCostMethod @default(BY_VALUE)
  sortOrder          Int              @default(0)

  po                 PurchaseOrder    @relation(fields: [poId], references: [id])
  invoiceLines       PurchaseInvoiceLine[]

  @@map("freight_cost_lines")
}

model PurchaseReceipt {
  id          String    @id @default(cuid())
  poId        String
  reference   String?
  externalKey String?   @unique
  receivedAt  DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  po          PurchaseOrder        @relation(fields: [poId], references: [id])
  lines       PurchaseReceiptLine[]

  @@map("purchase_receipts")
}

model PurchaseReceiptLine {
  id                   String    @id @default(cuid())
  receiptId            String
  poLineId             String
  qtyReceived          Decimal   @db.Decimal(12, 4)
  coveredBySnapshotQty Decimal   @db.Decimal(12, 4) @default(0)
  warehouseId          String?   // warehouse goods were received into

  receipt     PurchaseReceipt   @relation(fields: [receiptId], references: [id])
  poLine      PurchaseOrderLine @relation(fields: [poLineId], references: [id])

  @@index([receiptId])
  @@index([poLineId])
  @@map("purchase_receipt_lines")
}

model PurchaseInvoice {
  id              String    @id @default(cuid())
  poId            String
  invoiceNumber   String?
  invoiceDate     DateTime
  dueDate         DateTime?
  subtotalForeign Decimal   @db.Decimal(18, 4) @default(0)
  subtotalBase     Decimal   @db.Decimal(18, 4) @default(0)
  taxForeign      Decimal   @db.Decimal(18, 4) @default(0)
  taxBase          Decimal   @db.Decimal(18, 4) @default(0)
  totalForeign    Decimal   @db.Decimal(18, 4)
  totalBase        Decimal   @db.Decimal(18, 4)
  fxRateToBase     Decimal   @db.Decimal(18, 8)
  notes           String?
  supplierInvoiceUrl String? // path to uploaded supplier PDF
  // o3d-9kek: ONE external bill ↔ ONE local bill, enforced by the database.
  //
  // Two bills carrying the same external id is the catastrophic failure this whole area exists
  // to prevent: PURCHASE_INVOICE_UPDATE posts to /Invoices/{accountingInvoiceId}, so every later
  // correction to one bill silently rewrites the other's document in the ledger (see the o3d-9oq
  // note in app/actions/purchase-orders.ts). Until now nothing forbade it, so the invariant was
  // only ever upheld by protocol — a guard on one code path, in a separate statement from the
  // write, which no protocol can make atomic and a future writer can forget.
  //
  // GLOBAL, on the VALUE alone, and that is a deliberate trade rather than an oversight. Making it
  // per-connection — (id, provenance), which was tried and reverted — would let a QuickBooks realm
  // switch store the same integer twice, once per company. The write would then succeed and the
  // collision would move to the ~190 call sites that read a naked accountingInvoiceId, on models
  // (SalesOrder, SalesOrderRefund, SupplierCreditNote) that have no provenance column to consult
  // even in principle. Globally unique, the same situation is a BLOCKED WRITE with a loud error
  // naming a realm switch as the likely cause (see applyBackReference). Failing to repair is
  // acceptable; repairing onto the wrong bill is not. o3d-gt8r carries the tenant-isolation work
  // that would be needed before namespacing this is safe.
  //
  // Postgres does not treat NULLs as equal, so this is precisely a partial unique index over the
  // bills that HAVE an external id: any number of bills may be unlinked.
  accountingInvoiceId String?  @unique @map("accounting_invoice_id")
  // o3d-wf86: HOW this bill acquired that id. NULL means "nobody recorded it" — every row written
  // before this column existed, and that unknown is exactly the state that makes a conflict
  // unadjudicable, so it is left honest rather than backfilled with a guess.
  //
  // The authoritative bill-keyed sync and the legacy newest-unlinked-bill repair used to write the
  // same column the same way, so nothing downstream could tell a PROVEN link from a GUESSED one and
  // the sweep could only ever refuse (EXTERNAL_ID_LINKED_ELSEWHERE). Recording the source is half of
  // what an automatic resolution would need; the other half is connector-side confirmation — GET the
  // remote bill and compare it against the local one — which does not exist, so the sweep still
  // refuses and still names a manual action. This makes the refusal INFORMATIVE, not automatic.
  accountingInvoiceIdSource AccountingLinkSource? @map("accounting_invoice_id_source")
  paidAt          DateTime?
  paymentAccountId   String?   // connector account id (e.g. Xero bank AccountID) used to pay this bill
  paymentAccountName String?   // snapshot of the bank account name at payment time
  paymentReference   String?   // optional user-entered payment reference
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  po              PurchaseOrder @relation(fields: [poId], references: [id])
  lines           PurchaseInvoiceLine[]
  supplierCreditNotes SupplierCreditNote[]

  @@index([poId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id              String    @id @default(cuid())
  invoiceId       String
  poLineId        String?
  costLineId      String?
  description     String?
  qtyBilled       Decimal   @db.Decimal(12, 4)
  unitCostForeign Decimal   @db.Decimal(18, 6)
  totalForeign    Decimal   @db.Decimal(18, 4)
  totalBase        Decimal   @db.Decimal(18, 4)

  invoice         PurchaseInvoice    @relation(fields: [invoiceId], references: [id])
  poLine          PurchaseOrderLine? @relation(fields: [poLineId], references: [id])
  costLine        FreightCostLine?   @relation(fields: [costLineId], references: [id])

  @@index([invoiceId])
  @@index([poLineId])
  @@index([costLineId])
  @@map("purchase_invoice_lines")
}

model PurchaseReturn {
  id          String    @id @default(cuid())
  poId        String
  reference   String?
  // Client-supplied key (stable per return-dialog submit) that dedupes
  // double-submits/retries: a second call with the same key is a no-op.
  idempotencyKey String? @unique
  returnedAt  DateTime  @default(now())
  reason      String?
  notes       String?
  createdAt   DateTime  @default(now())

  po          PurchaseOrder      @relation(fields: [poId], references: [id])
  lines       PurchaseReturnLine[]

  @@map("purchase_returns")
}

model PurchaseReturnLine {
  id          String    @id @default(cuid())
  returnId    String
  poLineId    String
  qtyReturned Decimal   @db.Decimal(12, 4)
  warehouseId String?

  return      PurchaseReturn    @relation(fields: [returnId], references: [id])
  poLine      PurchaseOrderLine @relation(fields: [poLineId], references: [id])

  @@index([returnId])
  @@index([poLineId])
  @@map("purchase_return_lines")
}

// audit-g5u2: a supplier credit note recorded against a (freight) PO — e.g. a
// duplicate freight bill the supplier is crediting back. Once POSTED to the
// accounting connector it can offset the freight invoice so the PO becomes
// cancellable (g5u2.4) while the credit note keeps the GL balanced.
model SupplierCreditNote {
  id                    String                   @id @default(cuid())
  poId                  String
  // The freight PurchaseInvoice this credit note offsets (nullable: a credit may
  // be recorded before being tied to a specific bill).
  purchaseInvoiceId     String?
  // Denormalised supplier snapshot (resolved via the PO at record time), matching
  // how other purchasing rows avoid a hard Supplier relation.
  supplierId            String
  reference             String?
  creditNoteNumber      String?
  amountForeign         Decimal                  @db.Decimal(18, 4)
  amountBase            Decimal                  @db.Decimal(18, 4)
  currency              String
  fxRateToBase          Decimal                  @db.Decimal(18, 8)
  reason                String?
  notes                 String?
  status                SupplierCreditNoteStatus @default(DRAFT)
  // True for credit notes auto-created by the supplier-return flow. Lets the
  // return-credit top-up net only against prior RETURN credits (not manual
  // allowances), so a manual credit can't silently suppress return credit.
  isReturnGenerated     Boolean                  @default(false)
  // Accounting-connector credit-note id (Xero ACCPAYCREDIT), set once POSTED.
  //
  // o3d-9kek r6: ONE external credit note ↔ ONE local credit note, globally unique on the value.
  // This is the one of the four where the constraint has live work to do TODAY: Xero's
  // POST /CreditNotes is create-or-update on CreditNoteNumber (the o3d-6l3 ACCPAY defect, one
  // document type over), and buildSupplierCreditNotePayload falls back to the PURCHASE ORDER
  // REFERENCE when the operator leaves the number blank — so two manual credit notes on one PO can
  // post the same number, the second silently REPLACING the first in the ledger and returning its
  // id. Without this index that lands as two local rows pointing at one ledger document; with it,
  // the second link is refused loudly. The number-collision defect itself is o3d-tfri.
  accountingCreditNoteId String?                 @unique @map("accounting_credit_note_id")
  recordedAt            DateTime                 @default(now())
  postedAt              DateTime?
  createdBy             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  po                    PurchaseOrder            @relation(fields: [poId], references: [id])
  purchaseInvoice       PurchaseInvoice?         @relation(fields: [purchaseInvoiceId], references: [id])

  @@index([poId])
  @@index([supplierId])
  @@index([purchaseInvoiceId])
  @@map("supplier_credit_notes")
}

// ---------------------------------------------------------------------------
// CUSTOMERS
// ---------------------------------------------------------------------------

model Customer {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  accountingContactId String?
  // Provenance of accountingContactId — see Product.accountingItemProvenance (o3d-6nd).
  accountingContactProvenance String?
  email           String?
  phone           String?
  company         String?
  taxNumber       String?   // VAT / tax ID
  billingAddress  Json?     // { line1, line2, city, county, postcode, country }
  shippingAddress Json?     // { line1, line2, city, county, postcode, country }
  notes           String?
  externalCustomerId Int?    @unique // Shopping connector customer ID
  active          Boolean   @default(true)
  archived        Boolean   @default(false)
  gdprAnonymisedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  salesOrders     SalesOrder[]
  shoppingLinks   ShoppingCustomerLink[]

  @@unique([accountingContactId, accountingContactProvenance])
  @@map("customers")
}

// SALES ORDERS
// ---------------------------------------------------------------------------

model SalesOrder {
  id                String           @id @default(cuid())
  externalOrderNumber String?         // Storefront order number/reference
  status            SalesOrderStatus @default(DRAFT)
  // Refund disposition, orthogonal to the fulfilment `status` lifecycle (an order can
  // be e.g. Processing + Partially refunded, or Delivered + Fully refunded). Maintained
  // by the refund service; the legacy PARTIALLY_REFUNDED/REFUNDED `status` values are
  // being retired in favour of this field (epic: orthogonal refund status).
  refundStatus      RefundDisposition @default(NONE)
  /// o3d-e1yb [wdraw]: set when this order is ON_HOLD because the customer filed an EU
  /// right-of-withdrawal request in the storefront. It marks the hold as
  /// withdrawal-originated, which does two things nothing else does:
  ///   - an inbound storefront status change is REFUSED while it is set (a rejected
  ///     withdrawal returns the WooCommerce order to `processing`, and applying that
  ///     would let the WMS release pass re-push the order), and
  ///   - the WMS push sweep's release pass skips the link.
  /// Cleared when the withdrawal is approved (the order is cancelled instead) or when
  /// an operator releases the hold by hand. Automatic release is deliberately not
  /// implemented; see lib/connectors/woocommerce/sync/withdrawal.ts.
  withdrawalHoldAt  DateTime?
  /// o3d-e1yb [wdraw]: set when an EU withdrawal request was APPROVED and the order
  /// cancelled. Deliberately separate from `withdrawalHoldAt`, which is cleared at that
  /// point: the hold is over, but the fact is permanent. A delayed pre-approval
  /// storefront webhook would otherwise see no marker, fall through to the ordinary
  /// status mapping — which uses the full transition bypass — and force the cancelled
  /// order back to PROCESSING, making its WMS link releasable and re-sending withdrawn
  /// goods to the warehouse.
  withdrawalApprovedAt DateTime?
  /// o3d-6x66: monotonic counter, bumped once per NEWLY handled withdrawal
  /// submission. `withdrawalHoldAt` deliberately does NOT move on a repair or
  /// redelivery run — an operator needs to see how long an order has really
  /// been held — so it cannot distinguish "the same hold" from "a new customer
  /// request". Releasing compares this instead, so a stale release cannot clear
  /// a hold that now represents a newer request.
  withdrawalHoldGeneration Int @default(0)
  /// The withdrawal-related WooCommerce status last HANDLED for this order.
  /// Distinguishes a redelivery of the same event (same slug — do not bump the
  /// generation) from a genuinely NEW customer submission after a rejection
  /// (the slug moved away and back). Without it a resubmission arriving while
  /// a retained hold is still in place advances nothing, and an operator
  /// holding a stale generation could release the newer request.
  withdrawalLastWcStatus String?
  /// `date_modified_gmt` of the withdrawal event last handled. The inbox does
  /// not guarantee per-order ordering, so a DELAYED rejection can arrive after
  /// a newer resubmission; without a version it would overwrite the newer
  /// state and leave the generation stale. Older events are ignored.
  withdrawalLastWcEventAt DateTime?
  currency          String           @default("GBP")
  fxRateToBase       Decimal          @db.Decimal(18, 8) @default(1)

  // Customer
  customerId        String?
  customerName      String?
  customerEmail     String?
  customerVatNumber String?          // customer-entered VAT/IOSS number from the storefront, sent to the WMS for customs
  billingAddress    Json?
  shippingAddress   Json?

  // Totals (in order currency)
  subtotalForeign   Decimal          @db.Decimal(18, 4)
  shippingService   String?          // e.g. "Royal Mail", "DPD Next Day"
  shippingForeign   Decimal          @db.Decimal(18, 4) @default(0)
  taxRateName       String?          // e.g. "UK Standard Rate"
  taxRatePercent    Decimal?         @db.Decimal(5, 4) // e.g. 0.2000
  taxForeign        Decimal          @db.Decimal(18, 4) @default(0)
  pricesIncludeVat  Boolean          @default(false) // true when unit prices are tax-inclusive (display as gross)
  totalForeign      Decimal          @db.Decimal(18, 4)

  // Totals in GBP
  subtotalBase       Decimal          @db.Decimal(18, 4)
  shippingBase       Decimal          @db.Decimal(18, 4) @default(0)
  taxBase            Decimal          @db.Decimal(18, 4) @default(0)
  totalBase          Decimal          @db.Decimal(18, 4)

  // Fulfilment
  shipFromWarehouseId String?
  expectedDelivery  DateTime?
  salesRep          String?
  shippedAt         DateTime?
  trackingNumber    String?
  discountStr       String?    // order-level discount input e.g. "10%" or "5.00"
  discountAmount    Decimal    @db.Decimal(18, 4) @default(0) // computed order discount in foreign currency
  invoiceNumber     String?    // generated invoice reference
  invoicedAt        DateTime?
  paymentDueAt      DateTime?
  // o3d-9kek r6: ONE external invoice ↔ ONE local order, enforced by the database — the same
  // invariant as PurchaseInvoice.accountingInvoiceId, and for a sharper reason. Payment polling
  // selects EVERY order carrying a matching external id and marks each one paid, advances its
  // lifecycle and can auto-allocate it, so two orders sharing one InvoiceID means one customer
  // payment settles two orders; SALES_INVOICE_UPDATE then posts every later correction against a
  // document that belongs to both. Nothing in IMS legitimately shares one external invoice between
  // orders (no consolidated invoicing; a re-invoice becomes SALES_INVOICE_UPDATE, which does not
  // write this column; cloneSalesOrder deliberately does not copy it).
  //
  // Global and on the VALUE alone, deliberately — see PurchaseInvoice.accountingInvoiceId. NULLs are
  // not equal in Postgres, so any number of orders may be unlinked.
  accountingInvoiceId     String?    @unique @map("accounting_invoice_id") // Accounting invoice ID after sync
  paidAt            DateTime?
  orderNumber       String?    // IMS order number (prefix + WC number, or manual)
  paymentMethod     String?    // e.g. "stripe", "paypal", "bacs" — populated by any shopping channel
  paymentMethodTitle String?   // e.g. "Credit card", "PayPal"
  invoicePdfPath    String?    // path to saved invoice PDF (generic, set by any accounting module)

  // Accounting sub-ledger tracking
  revenueDeferredDate    DateTime?              @map("accounting_revenue_deferred_date") // Set by Group A1 — revenue deferred to Unearned
  unearnedRevenueAmount  Decimal?  @db.Decimal(18, 4) @map("accounting_unearned_revenue_amount") // Amount deferred
  inventoryAllocatedDate DateTime?              @map("accounting_inventory_allocated_date") // Set by Group A2 — inventory reclassified to Allocated
  allocationBatchAmount  Decimal?  @db.Decimal(18, 4) @map("accounting_allocation_batch_amount") // Cost value reclassified
  // o3d-0qoo: the EXACT AccountingSyncLog.referenceId of the batch this row was staged into,
  // written in the same transaction as the stamp beside it. Batch identity used to be
  // re-derived from the stamp by every consumer, which disagrees with the run-start date the
  // batch was actually keyed on whenever a run crosses UTC midnight. NULL on pre-migration
  // rows (and on rows staged into a batch that produced no journal), where consumers fall
  // back to deriving from the stamp.
  revenueDeferredBatchRef    String?            @map("accounting_revenue_deferred_batch_ref")
  inventoryAllocatedBatchRef String?            @map("accounting_inventory_allocated_batch_ref")
  // o3d-o97 r3 — WHAT A2 ACTUALLY RAISED, AND WHERE.
  //
  // `allocationBatchAmount` above says how many pounds A2 VALUED this order at. It does NOT say a
  // journal was ever created (the batch log is raised only when the window's ROUNDED total is
  // positive, while the amount is written for every member row), it does not say that journal
  // reached a ledger, and it names no ledger and no account. A refund crediting Allocated
  // Inventory off that number alone can credit an account that was never debited, or the wrong
  // ledger entirely after a connector switch.
  //
  // These three are written in the SAME UPDATE as the stamp and the amount, and only when the A2
  // journal row was actually created:
  //
  //   syncLogId   the AccountingSyncLog row's own id — a value that cannot exist unless
  //               `createPendingSyncLog` created the row, so an amount can no longer imply a
  //               journal. It is also the handle the refund resolves to read that row's STATUS:
  //               queued is not posted, and CANCELLED/FAILED is not posted at all.
  //   connector   which LEDGER the journal was raised into. A reversal is raised on the connector
  //               that is active NOW; if that is not the one A2 debited, the credit lands in a
  //               ledger with no matching debit.
  //   accountCode the exact Allocated Inventory account A2 DEBITED. The reversal credits whatever
  //               the settings name today, which is not necessarily the same account.
  //
  // NULL on rows staged before these columns existed: there is nothing that can retroactively
  // prove a 2025 batch posted, so those rows keep the older amount-implies-posting inference.
  allocationBatchSyncLogId   String?            @map("accounting_allocation_batch_sync_log_id")
  allocationBatchConnector   String?            @map("accounting_allocation_batch_connector")
  allocationBatchAccountCode String?            @map("accounting_allocation_batch_account_code")

  notes             String?     // customer-visible notes
  internalNotes     String?     // private/staff notes

  externalCreatedAt DateTime?        // order date in shopping connector
  externalUpdatedAt DateTime?
  archived          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  customer          Customer?        @relation(fields: [customerId], references: [id])
  shipFromWarehouse Warehouse?       @relation("ShipFromWarehouse", fields: [shipFromWarehouseId], references: [id])
  lines             SalesOrderLine[]
  refunds           SalesOrderRefund[]
  payments          Payment[]
  allocations       OrderAllocation[]
  shipments         Shipment[]
  shoppingLinks     ShoppingOrderLink[]
  wmsReturnsInbox   WmsReturnsInbox[] @relation("WmsReturnsInboxOrder")
  wmsOrderStatus    WmsOrderStatusSnapshot?
  wmsOrderPush      WmsOrderPushLink?
  wmsOrderDiscrepancies WmsOrderDiscrepancy[]

  @@index([status])
  @@index([status, updatedAt(sort: Desc)], map: "sales_orders_status_updatedAt_idx")
  @@index([createdAt])
  // o3d-0qoo: "which orders are in batch <ref>" — the reverse of the delete guard's lookup.
  @@index([revenueDeferredBatchRef], map: "sales_orders_revenue_deferred_batch_ref_idx")
  @@index([inventoryAllocatedBatchRef], map: "sales_orders_inventory_allocated_batch_ref_idx")
  @@map("sales_orders")
}

model SalesOrderLine {
  id              String     @id @default(cuid())
  orderId         String
  productId       String?    // null if product deleted / not found
  externalLineItemId Int?
  description     String
  sku             String?
  qty             Decimal    @db.Decimal(12, 4)
  unitPriceForeign Decimal   @db.Decimal(18, 6)  // original price before discount
  unitPriceBase    Decimal    @db.Decimal(18, 6)
  discountStr     String?    // e.g. "5%" or "2.50" — original user input
  discountAmount  Decimal    @db.Decimal(18, 4) @default(0) // computed line discount amount in foreign currency
  taxRateId       String?
  taxForeign      Decimal    @db.Decimal(18, 4) @default(0)
  taxBase          Decimal    @db.Decimal(18, 4) @default(0)
  totalForeign    Decimal    @db.Decimal(18, 4)
  totalBase        Decimal    @db.Decimal(18, 4)
  cogsBase         Decimal?   @db.Decimal(18, 4) // set on dispatch
  /// o3d-kouj: THE IMMUTABLE FULFILMENT-REQUIREMENT SNAPSHOT — the flat leaf requirement set for ONE
  /// unit of this line's product, as expanded from the component graph at the moment this line first
  /// acquired in-flight state (an allocation row). While the line holds an allocation row or a
  /// committed shipment line it is never rewritten, so a later component-graph edit cannot change
  /// what this order requires, what its picked set is judged against, or what its refund reverses.
  ///
  /// NULL means "no pinned recipe": the line has never been allocated, or predates this column. Every
  /// reader resolves through `lineFulfillmentRequirements`, which falls back to expanding the current
  /// graph — exactly the pre-snapshot behaviour — so there is ONE rule rather than a snapshot-aware
  /// and a live-graph population that disagree about the same order.
  ///
  /// Shape: { version, productId, graphVersion, capturedAt, requirements: [{ productId, factor }] }
  /// with `factor` an exact decimal STRING. See lib/products/fulfillment-requirement-snapshot.ts,
  /// which is the only thing allowed to parse it and refuses rather than falling back when the
  /// payload is present but unreadable.
  fulfillmentRequirements Json? @map("fulfillment_requirements")

  order           SalesOrder @relation(fields: [orderId], references: [id])
  product         Product?   @relation(fields: [productId], references: [id])
  taxRate         TaxRate?   @relation(fields: [taxRateId], references: [id])
  allocations     OrderAllocation[]
  shipmentLines   ShipmentLine[]
  refundLines     SalesOrderRefundLine[]

  @@index([orderId])
  @@index([productId])
  @@map("sales_order_lines")
}

model SalesOrderRefund {
  id              String     @id @default(cuid())
  orderId         String
  creditNoteNumber String?   // e.g. "CN-2025-00001"
  // o3d-9kek r6: ONE external credit note ↔ ONE local refund. Each refund mints its own sequential
  // creditNoteNumber and gets its own CREDIT_NOTE sync row, and the external-refund/chargeback
  // replay paths return the EXISTING refund rather than creating a second one — so no split or
  // partial refund legitimately shares a credit note. Global, on the value alone, NULLs unconstrained.
  accountingCreditNoteId String?   @unique @map("accounting_credit_note_id") // Accounting credit note ID after sync
  externalRefundId Int?
  returnWarehouseId String?
  reason          String?
  totalForeign    Decimal    @db.Decimal(18, 4)
  totalBase        Decimal    @db.Decimal(18, 4)
  // What the stored totals MEAN, and which trusted writer created the refund (o3d-n8p). Set by the
  // writer (never a caller option) so refund classification is a lookup, not a reconstruction. totalsBasis
  // is 'NET' for every refund created since the net contract; a NULL row is a legacy refund whose totals
  // are GROSS. The o3d-w00 net ceiling/status is only applied when ALL of an order's refunds are NET —
  // otherwise a mixed gross+net sum could mark an order FULL early, so it falls back to the gross basis.
  totalsBasis     String?    @map("totals_basis")
  source          String?
  accountingRetryRequired Boolean @default(false) @map("accounting_retry_required")
  accountingWarning String?   @map("accounting_warning")
  // o3d-o97 r3: THE CR ALLOCATED INVENTORY THIS REFUND'S OWN REVERSAL JOURNAL RAISED, written in
  // the same transaction that decides it. A later refund on the same order must subtract what
  // earlier refunds already relieved, and its only previous source was the earlier refund's
  // UNEARNED_REV_REVERSAL sync payload — a row `retention_sync_logs_months` HARD-DELETES once it
  // terminalises. With the row gone the relief reads ZERO and the residue reverses the whole A2
  // debit a second time. Refund rows are never deleted by retention.
  allocatedReliefAmount Decimal? @db.Decimal(18, 4) @map("accounting_allocated_relief_amount")
  // o3d-o97 r3: why this refund could NOT account for the order's A2 debit, or null when it could.
  // A refusal has to leave a remedy an operator can actually perform: the un-stage below is
  // SUPPRESSED whenever this is set, so the A2 stamp survives and the standing A2 invariants keep
  // reporting the order — and this string says, on a row that outlives the order's stamps, which
  // record was missing and how many pounds are still sitting in Allocated Inventory.
  allocationBasisUnresolved String? @map("accounting_allocation_basis_unresolved")
  accountingRetrySyncs Json?  @map("accounting_retry_syncs")
  // scjz.70: revenue-only chargeback — credit note reverses recognised revenue
  // against AR, but COGS reversal + inventory restock are suppressed (cost kept as
  // a loss, goods not returned). Persisted so an accounting retry that re-stages
  // reproduces the treatment.
  chargeback      Boolean    @default(false)
  // scjz.71: whether this refund STAGED a COGS/unearned reversal (durable, set at
  // staging time). Distinguishes a fully-shipped chargeback (no reversal staged —
  // credit-note-only, exempt from reversal-evidence checks) from a partial/deferred
  // chargeback that staged an UNEARNED_REV_REVERSAL and must still have that evidence.
  // accountingRetrySyncs is cleared once syncs queue, so it can't carry this.
  reversalStaged  Boolean    @default(false)
  refundedAt      DateTime   @default(now())
  createdAt       DateTime   @default(now())

  order           SalesOrder @relation(fields: [orderId], references: [id])
  returnWarehouse Warehouse? @relation(fields: [returnWarehouseId], references: [id])
  lines           SalesOrderRefundLine[]
  payments        Payment[]

  @@unique([externalRefundId])
  @@index([orderId])
  @@map("sales_order_refunds")
}

model SalesOrderRefundLine {
  id              String           @id @default(cuid())
  refundId        String
  salesOrderLineId String?         @map("sales_order_line_id")
  productId       String?
  description     String
  qty             Decimal          @db.Decimal(12, 4)
  unitPriceForeign Decimal         @db.Decimal(18, 6) @default(0)
  unitPriceBase    Decimal          @db.Decimal(18, 6)
  totalForeign     Decimal          @db.Decimal(18, 4) @default(0)
  totalBase        Decimal          @db.Decimal(18, 4)
  costLayerSnapshot Json?
  // The VAT identity RESOLVED AT CREATION (o3d-w00), so the credit note posts under the rate the invoice
  // actually validated instead of re-predicting it from the order default at post time — which mis-taxed
  // deactivated-rate, reverse-charged and mixed-rate refunds. accountingTaxType is the resolved connector
  // tax type (reverse-charge swap already applied); reverseCharge records whether the swap applied, for
  // audit. NULL on legacy rows and on lines whose identity could not be established (the credit note
  // refuses those rather than guessing). amounts on this model are NET (tax-exclusive) for every caller.
  accountingTaxType String?
  reverseCharge    Boolean?
  // The posting kind resolved AT CREATION (o3d-w00 #4). Persisted so an accounting RETRY posts to the
  // same account the initial run did, instead of re-inferring it from productId/amount sign — that
  // inference reconstructs a monetary-only 'sale' line (null product, positive total) as 'shipping', so
  // revenue lands in the shipping account on retry. NULL on legacy rows: the loader keeps its historical
  // inference for those, so no backfill is required and existing behaviour is unchanged.
  lineKind         String?

  refund          SalesOrderRefund @relation(fields: [refundId], references: [id])
  salesOrderLine  SalesOrderLine?  @relation(fields: [salesOrderLineId], references: [id], onDelete: SetNull)
  product         Product?         @relation(fields: [productId], references: [id])

  @@index([refundId])
  @@index([salesOrderLineId], map: "sales_order_refund_lines_sales_order_line_id_idx")
  @@index([productId])
  @@index([costLayerSnapshot(ops: JsonbOps)], type: Gin, map: "sales_order_refund_lines_costLayerSnapshot_gin_idx")
  @@map("sales_order_refund_lines")
}

/// Payments recorded against sales orders (invoices) or credit notes (refunds)
model Payment {
  id              String    @id @default(cuid())
  orderId         String
  refundId        String?   // null = payment against invoice, set = payment against credit note
  amount          Decimal   @db.Decimal(18, 4) // positive for receipts, negative for credit note payments
  currency        String    @default("GBP")
  method          String?   // e.g. "Bank Transfer", "Card", "Cash", "PayPal"
  reference       String?   // payment ref / transaction ID
  notes           String?
  paidAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  order           SalesOrder       @relation(fields: [orderId], references: [id])
  refund          SalesOrderRefund? @relation(fields: [refundId], references: [id])

  @@index([orderId])
  @@index([refundId])
  @@map("payments")
}

