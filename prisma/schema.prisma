model WmsOrderStatusSnapshot {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  connector           String
  connectorLabel      String
  externalOrderId     String
  externalOrderNumber String
  status              String
  statusLabel         String
  isSplit             Boolean  @default(false)
  partCount           Int?
  isMerged            Boolean  @default(false)
  mergedOrderNumbers  String[] @default([])
  deepLinkUrl         String?
  trackingNumber      String?
  carrier             String?
  fetchedAt           DateTime @default(now())
  lastError           String?
  // Last WMS status successfully pushed to the storefront (G4). Decoupled from `status`
  // so a failed storefront push isn't masked by the cached-status change gate — it retries.
  wcPushedStatus      String?

  order               SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([connector])
  @@index([fetchedAt])
  @@map("wms_order_status_snapshots")
}

// Outbound push state for an IMS sales order sent to a WMS for fulfilment
// (Phase 8). The push sweep is the writer; `externalOrderId` is the stable join
// to the WMS order after a successful create. Connector-agnostic.
enum WmsOrderPushState {
  PENDING_CREATE
  /// o3d-bjc.8: the WMS create SUCCEEDED and minted an id, but we have not yet
  /// proved that id is ours. Distinct from SYNCED because it must never be
  /// re-PUT — a second create would duplicate a real warehouse order — and
  /// distinct from PENDING_CREATE for the same reason. The sweep retries only
  /// the ClientId-scoped VERIFICATION until it resolves.
  PENDING_VERIFY
  SYNCED
  PENDING_CANCEL
  CANCELLED
  DEAD_LETTER
  HELD
  MERGED
}

model WmsOrderPushLink {
  id                  String            @id @default(cuid())
  orderId             String            @unique
  connector           String
  externalOrderId     String?
  externalOrderNumber String?
  state               WmsOrderPushState @default(PENDING_CREATE)
  attempts            Int               @default(0)
  lastError           String?
  lastAttemptAt       DateTime?
  pushedAt            DateTime?
  cancelledAt         DateTime?
  // G6 review flags (non-blocking; the order is still pushed). courierPending: the order's
  // shipping service didn't map to a WMS courier and we fell back to a configured default id,
  // so an operator should confirm/pick the courier in the WMS; auto-cleared when the WMS
  // order-status sweep reports a resolved courier name. totalMismatchPence: the order's own
  // totals did not reconcile to within a penny at push time (surfaced for review).
  courierPending      Boolean           @default(false)
  totalMismatchPence  Int?
  /// 6oyu.2: dispatch-reconciliation dead-letter. The dispatch sweep counts
  /// CONSECUTIVE per-order reconcile errors here (reset on success/pending);
  /// at the cap the link is dead-lettered (dispatchDeadLetteredAt set), leaves
  /// the sweep's candidate set, and surfaces in the sync exception inbox.
  dispatchFailureCount   Int            @default(0)
  dispatchLastError      String?
  dispatchDeadLetteredAt DateTime?
  /// o3d-bjc.9: CONSECUTIVE unresolved reads — the WMS answered, but its record
  /// could not be turned into a dispatch state (an unreadable part set, a status
  /// the vocabulary does not carry). Deliberately NOT dispatchFailureCount: that
  /// counts transport/apply failures, and folding the two together is what made
  /// an earlier attempt dead-letter a whole tenant on one schema change. At the
  /// cap the link is QUARANTINED (dispatchUnresolvedAt set): it leaves the
  /// candidate set and stops pinning the delta watermark, and surfaces in the
  /// sync exception inbox. Reset on the first resolved read.
  dispatchUnresolvedCount Int           @default(0)
  dispatchUnresolvedError String?
  dispatchUnresolvedAt    DateTime?
  /// q66in.4.4: when the order reconcile last verified this link against the
  /// WMS — the capped daily sweep rotates least-recently-checked first.
  reconcileCheckedAt     DateTime?
  /// o3d-bjc: when the DISPATCH sweep last verified this link's WMS state
  /// (via the Order/List delta OR the throttled per-order reconcile). The
  /// batched reconcile pass orders by this (nulls first) so links beyond the
  /// first `batchSize` rotate in instead of the same oldest orders being
  /// re-polled forever. Distinct from reconcileCheckedAt, which the separate
  /// q66in.4.4 order-reconcile sweep owns — the two must not clobber each other.
  dispatchReconcileCheckedAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  order               SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([connector, state])
  @@index([dispatchDeadLetteredAt])
  /// o3d-bjc: supports the dispatch reconcile-pass rotation ordering.
  @@index([connector, dispatchReconcileCheckedAt])
  @@index([connector, dispatchUnresolvedAt])
  @@map("wms_order_push_links")
}

