model ActivityLog {
  id          String             @id @default(cuid())
  userId      String?
  entityType  ActivityEntityType
  entityId    String?
  action      String             // e.g. "created", "updated", "deleted", "status_changed"
  tag         String             // human-friendly category: sales, purchase, inventory, stock, sync, settings, auth, import, manufacturing, system
  level       ActivityLogLevel   @default(INFO)
  description String             // human-readable clear text
  metadata    Json?              // diff or extra context
  createdAt   DateTime           @default(now())

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([tag])
  @@index([level])
  @@index([level, createdAt])
  @@map("activity_logs")
}

model CronRun {
  id           String    @id @default(cuid())
  runId        String    @unique
  jobName      String
  startedAt    DateTime
  finishedAt   DateTime?
  durationMs   Int?
  status       String
  countsJson   Json?
  statusReason String?
  createdAt    DateTime  @default(now())

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("cron_runs")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  // null = broadcast to all users
  type      String   // info | success | warning | error
  title     String
  message   String
  actionUrl String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  readAt    DateTime?

  /// Cascade, NOT SetNull (Codex r7): userId=null means "broadcast to all
  /// users", so nulling on recipient deletion converted targeted (often
  /// admin-only, operationally sensitive) notifications into broadcasts.
  user         User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  readReceipts NotificationReadReceipt[]

  @@index([userId, read, createdAt])
  @@map("notifications")
}

/// Per-user read receipt for notifications.
/// Broadcast notifications (userId=null) use this table so that marking them
/// read only affects the calling user, not everyone.
model NotificationReadReceipt {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_read_receipts")
}

