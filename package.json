{
  "name": "onetwoinventory",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:unit": "tsx --test --experimental-test-module-mocks \"tests/**/*.test.ts\"",
    "check:decimal-boundaries": "node scripts/check-domain-decimal-boundaries.mjs",
    "check:connector-fetch-boundaries": "node scripts/check-connector-fetch-boundaries.mjs",
    "check:wms-connector-boundary": "node scripts/check-wms-connector-boundary.mjs",
    "check:migration-conventions": "node scripts/check-migration-conventions.mjs",
    "check:documented-env-vars": "node scripts/check-documented-env-vars.mjs",
    "check:all": "npm run check:decimal-boundaries && npm run check:connector-fetch-boundaries && npm run check:wms-connector-boundary && npm run check:migration-conventions && npm run check:documented-env-vars && npm run check:server-action-guards",
    "test:concurrency": "RUN_DB_CONCURRENCY_TESTS=1 tsx --test \"tests/concurrency/**/*.test.ts\"",
    "docs:workflows": "tsx scripts/generate-workflow-docs.ts",
    "docs:workflows:check": "tsx scripts/generate-workflow-docs.ts --check",
    "preflight:production": "tsx scripts/preflight-production.ts",
    "invariant-check:preflight": "tsx scripts/invariant-check-preflight.ts",
    "invariant-check:preflight:fixture": "tsx scripts/invariant-check-preflight-fixture.ts",
    "inventory:snapshots:backfill": "tsx scripts/backfill-inventory-snapshots.ts",
    "wc:coupon-discount:backfill": "tsx scripts/backfill-wc-coupon-order-discount.ts",
    "validate": "bash scripts/validate-local.sh",
    "validate:db": "bash scripts/validate-db.sh",
    "db:migrate:status": "bash scripts/prisma-dev-db.sh status",
    "db:migrate:deploy": "bash scripts/prisma-dev-db.sh deploy",
    "db:schema:diff": "bash scripts/prisma-dev-db.sh diff",
    "db:pull": "bash scripts/prisma-dev-db.sh db-pull",
    "db:generate": "bash scripts/prisma-dev-db.sh generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:e2e": "tsx e2e/prepare.ts",
    "db:studio": "prisma studio",
    "db:schema:drift": "node scripts/check-prisma-drift.mjs",
    "db:schema:scope": "node scripts/check-prisma-schema-scope.mjs",
    "cli": "tsx scripts/cli.ts",
    "e2e": "NODE_OPTIONS='--import tsx' playwright test",
    "e2e:select": "node scripts/e2e-select.mjs",
    "e2e:external": "NODE_OPTIONS='--import tsx' playwright test --grep @external",
    "e2e:wc": "NODE_OPTIONS='--import tsx' playwright test --grep @wc",
    "e2e:xero": "NODE_OPTIONS='--import tsx' playwright test --grep @xero",
    "e2e:full-chain": "NODE_OPTIONS='--import tsx' playwright test --config playwright.full-chain.config.ts",
    "e2e:full-chain:preflight": "NODE_OPTIONS='--import tsx' node --env-file=.env scripts/full-chain-preflight.ts",
    "e2e:full-chain:restore": "NODE_OPTIONS='--import tsx' node --env-file=.env scripts/restore-stage-connectors.ts",
    "e2e:headed": "NODE_OPTIONS='--import tsx' playwright test --headed",
    "e2e:ui": "NODE_OPTIONS='--import tsx' playwright test --ui",
    "refunds:basis:backfill": "tsx scripts/backfill-refund-basis.ts",
    "check:server-action-auth-bypass": "node scripts/check-server-action-auth-bypass.mjs",
    "check:server-action-guard-coverage": "tsx --test --experimental-test-module-mocks tests/security/server-action-guard-coverage.test.ts tests/security/server-action-guard-detector.test.ts tests/security/module-graph.test.ts",
    "check:server-action-authorization": "tsx --test --experimental-test-module-mocks tests/security/accounting-dispatcher-authorization.test.ts tests/security/accounting-read-authorization.test.ts tests/security/company-email-settings-authorization.test.ts tests/security/setting-secret-read-authorization.test.ts tests/security/settings-page-authorization.test.ts tests/security/recording-db.test.ts tests/security/supplier-isolation.test.ts tests/security/supplier-portal-boundary.test.ts tests/security/server-action-auth.test.ts",
    "check:server-action-guards": "npm run check:server-action-auth-bypass && npm run check:server-action-guard-coverage && npm run check:server-action-authorization"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@base-ui/react": "^1.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "~1.7.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.1.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/pdfkit": "^0.17.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^7.8.0",
    "shadcn": "^4.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.13 <2",
    "postcss": "^8.5.17"
  }
}
