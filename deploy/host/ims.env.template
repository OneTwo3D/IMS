# /etc/ims/ims.env: the runtime environment of BOTH app slots (docker --env-file: one NAME=value per line, no quotes, no `export`,
# the value is everything after the first '=').
#
# Owner root, mode 0600. It is rendered from the password manager by a separate task; it is never committed and never passed on a
# command line. This file only names what must be there. Anything else in .env.example is optional.

# Postgres 17 runs natively on this host; both slots use the host network, so loopback reaches it.
DATABASE_URL=postgresql://<role>:<password>@127.0.0.1:5432/<database>

AUTH_SECRET=<openssl rand -base64 32>
SETTINGS_ENCRYPTION_KEY=<32 raw bytes, base64 of 32 bytes, or 64 hex chars>
# At least 32 characters. /etc/ims/cron.env holds the same value as CRON_SECRET=<value> for the host cron lines.
CRON_SECRET=<at least 32 characters>

# The public origin. The two must share an origin.
AUTH_URL=https://ims.onetwo3d.co.uk
NEXT_PUBLIC_APP_URL=https://ims.onetwo3d.co.uk

# REQUIRED: deploy.sh refuses to start a release without it. `all` holds every connector writer (Mintsoft, Xero, WooCommerce) at the
# producer seam. Change it only as part of the deliberate release of the connectors.
PRODUCER_HOLD_ENFORCED_DESTINATIONS=all

# Persistent storage and backups. Both slots bind-mount the host directory /srv/ims/state on /var/lib/onetwoinventory (see deploy.sh run_slot),
# so these container paths are what the app, and production preflight run in the same container, actually see. They match the image's own
# defaults; they are listed here because production preflight refuses to pass unless each is set explicitly. Leave the values as they are
# unless the mount in deploy.sh changes with them. host-bootstrap.sh creates the four directories under /srv/ims/state (1001:1001, 0750).
BACKUP_DIR=/var/lib/onetwoinventory/backups
UPLOAD_STORAGE_DIR=/var/lib/onetwoinventory/uploads
PUBLIC_UPLOAD_STORAGE_DIR=/var/lib/onetwoinventory/public-uploads
# INVOICE_PDF_STORAGE_DIR MUST be in the backup set: stored invoice PDFs are retained for 6 years (host path /srv/ims/state/invoice-pdfs).
INVOICE_PDF_STORAGE_DIR=/var/lib/onetwoinventory/invoice-pdfs

# Invoice PDF malware scanning: `disabled` or `command`. The runtime image ships no scanner, so `disabled` is the value that works (preflight
# reports a warning, not a failure). Switch to `command` only together with FILE_SCAN_COMMAND_ARGV and a scanner the container can run
# (see docs/ops/invoice-pdf-malware-scanning.md). It stays `disabled` for now; it is to be switched on at switchover (the owner's decision).
FILE_SCAN_MODE=disabled

# PORT and HOSTNAME are set per slot by deploy.sh and override anything here. Do not set them.
