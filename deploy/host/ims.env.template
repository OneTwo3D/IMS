# /etc/ims/ims.env: the runtime environment of BOTH app slots (docker --env-file: one NAME=value per line, no quotes, no `export`,
# the value is everything after the first '=').
#
# Owner root, mode 0600. It is rendered from the password manager by a separate task; it is never committed and never passed on a
# command line. This file only names what must be there. Anything else in .env.example is optional.

# Postgres 17 runs natively on this host; both slots use the host network, so loopback reaches it.
DATABASE_URL=postgresql://<role>:<password>@127.0.0.1:5432/<database>

AUTH_SECRET=<openssl rand -base64 32>
SETTINGS_ENCRYPTION_KEY=<32 raw bytes, base64 of 32 bytes, or 64 hex chars>
# At least 32 characters. /etc/ims/cron.env holds the same value as CRON_SECRET=<value> for the host cron lines.
CRON_SECRET=<at least 32 characters>

# The public origin. The two must share an origin.
AUTH_URL=https://ims.onetwo3d.co.uk
NEXT_PUBLIC_APP_URL=https://ims.onetwo3d.co.uk

# REQUIRED: deploy.sh refuses to start a release without it. `all` holds every connector writer (Mintsoft, Xero, WooCommerce) at the
# producer seam. Change it only as part of the deliberate release of the connectors.
PRODUCER_HOLD_ENFORCED_DESTINATIONS=all

# PORT and HOSTNAME are set per slot by deploy.sh and override anything here. Do not set them.
