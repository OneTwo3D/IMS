#!/usr/bin/env bash
# Test stub for docker. State lives in $STUB (set by deploy/tests/run.sh); every call is appended to $STUB/calls.log.
set -u
echo "docker $*" >> "$STUB/calls.log"
cdir="$STUB/containers"; mkdir -p "$cdir"
case "${1:-}" in
  pull) [ ! -e "$STUB/pull_fail" ] ;;
  logs) exit 0 ;;
  inspect)
    name="${*: -1}"
    [ -f "$cdir/$name" ] || exit 1
    # shellcheck disable=SC1090
    . "$cdir/$name"
    case "$*" in *Config.Image*) echo "$image" ;; esac ;;
  rm) for a in "${@:2}"; do case "$a" in -*) ;; *) rm -f "$cdir/$a" ;; esac; done ;;
  stop|start)
    f="$cdir/$2"; [ -f "$f" ] || exit 1
    v=0; [ "$1" = start ] && v=1
    sed -i "s/^running=.*/running=$v/" "$f" ;;
  run)
    shift
    name="" entry="" detach=0 port="" image=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -d) detach=1 ;;
        --rm) ;;
        --name) name="$2"; shift ;;
        --entrypoint) entry="$2"; shift ;;
        --restart|--network|--env-file|-v) shift ;;
        -e) case "$2" in PORT=*) port="${2#PORT=}" ;; esac; shift ;;
        *) image="$1"; shift; break ;;
      esac
      shift
    done
    sha="${image##*:}"
    if [ "$detach" = 1 ]; then
      printf 'image=%s\nrunning=1\nport=%s\n' "$image" "$port" > "$cdir/$name"
      echo "RUN-SLOT $name $sha port=$port" >> "$STUB/calls.log"
    elif [ "$entry" = sh ] && [[ "$image" == */ims-migrate:* ]]; then
      cat "$STUB/migs/$sha"
    elif [ "$entry" = sh ]; then
      [ -e "$STUB/no_table" ] || cat "$STUB/applied"
    elif [ "$entry" = node ]; then
      [ ! -e "$STUB/render_fail" ] || exit 1
      cat "$STUB/cronout"
    else
      echo "MIGRATE $sha" >> "$STUB/calls.log"
      [ ! -e "$STUB/migrate_fail" ]
    fi ;;
  *) exit 0 ;;
esac
