#!/usr/bin/env bash
# Test stub for docker. State lives in $STUB (set by deploy/tests/run.sh); every call is appended to $STUB/calls.log.
set -u
echo "docker $*" >> "$STUB/calls.log"
# <repo>_<sha>, e.g. ims_aaaa… or ims-migrate_aaaa…
image_key() { local ref="$1" repo; repo="${ref%%:*}"; printf "%s_%s" "${repo##*/}" "${ref##*:}"; }
cdir="$STUB/containers"; mkdir -p "$cdir"
case "${1:-}" in
  pull) [ ! -e "$STUB/pull_fail" ] || exit 1; rm -f "$STUB/missing_image_$(image_key "${*: -1}")" ;;
  image) [ ! -e "$STUB/missing_image_$(image_key "${*: -1}")" ] ;;
  logs) exit 0 ;;
  inspect)
    name="${*: -1}"
    [ -f "$cdir/$name" ] || exit 1
    # shellcheck disable=SC1090
    . "$cdir/$name"
    case "$*" in
      *Config.Image*) echo "$image" ;;
      *State.Running*) if [ "$(sed -n 's/^running=//p' "$cdir/$name")" = 1 ]; then echo true; else echo false; fi ;;
    esac ;;
  rm) for a in "${@:2}"; do case "$a" in -*) ;; *) rm -f "$cdir/$a" ;; esac; done ;;
  stop|start)
    cname="${*: -1}"; f="$cdir/$cname"; [ -f "$f" ] || exit 1
    [ ! -e "$STUB/stop_fail_$cname" ] || [ "$1" != stop ] || exit 1            # a container that cannot be stopped
    [ ! -e "$STUB/stop_ignored_$cname" ] || [ "$1" != stop ] || exit 0         # docker says ok, the container keeps running
    v=0; [ "$1" = start ] && v=1
    sed -i "s/^running=.*/running=$v/" "$f" ;;
  run)
    shift
    name="" entry="" detach=0 port="" image="" envfile=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -d) detach=1 ;;
        --rm) ;;
        --name) name="$2"; shift ;;
        --entrypoint) entry="$2"; shift ;;
        --env-file) envfile="$2"; shift ;;
        --restart|--network|-v) shift ;;
        -e) case "$2" in PORT=*) port="${2#PORT=}" ;; esac; shift ;;
        *) image="$1"; shift; break ;;
      esac
      shift
    done
    sha="${image##*:}"
    if [ "$detach" = 1 ]; then
      [ -z "$envfile" ] || cp "$envfile" "$STUB/env_at_run_$name"      # what the container is created with
      printf 'image=%s\nrunning=1\nport=%s\n' "$image" "$port" > "$cdir/$name"
      echo "RUN-SLOT $name $sha port=$port" >> "$STUB/calls.log"
    elif [ "$entry" = sh ] && [[ "$image" == */ims-migrate:* ]]; then
      cat "$STUB/migs/$sha"
    elif [ "$entry" = node ] && [ "${1:-}" = -e ]; then   # the applied-migrations query
      [ -e "$STUB/no_table" ] || cat "$STUB/applied"
    elif [ "$entry" = node ]; then
      [ ! -e "$STUB/render_fail" ] || exit 1
      cat "$STUB/cronout"
    else
      echo "MIGRATE $sha" >> "$STUB/calls.log"
      [ ! -e "$STUB/migrate_fail" ]
    fi ;;
  *) exit 0 ;;
esac
